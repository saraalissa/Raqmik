{%- comment -%}
  Black Friday reservation window: 27 Nov 2026 00:01 to 30 Nov 2026 23:59 UK time (GMT = UTC in November).
  Inside the window: adds class "mv-bf" to <html>, swaps the announcement bar and the pop-up headline.
  Outside the window nothing changes. Preview only: add ?bf=1 on an unpublished-theme preview to see it early.
{%- endcomment -%}
<script>
(function(){
  var n=Date.now(),on=n>=Date.UTC(2026,10,27,0,1,0)&&n<=Date.UTC(2026,10,30,23,59,59),soon=n<Date.UTC(2026,10,27,0,1,0);
  try{var live=!window.Shopify||!Shopify.theme||Shopify.theme.role==='main';
    if(!live){var q=new URLSearchParams(location.search).get('bf');if(q==='1'){sessionStorage.setItem('mv_bf_test','1')}else if(q==='0'){sessionStorage.removeItem('mv_bf_test')}
      if(sessionStorage.getItem('mv_bf_test')==='1'){on=true;soon=false;}}}catch(e){}
  if(soon&&!on){document.documentElement.classList.add('mv-bf-soon');
    var sr=function(){document.querySelectorAll('.mv5-head .ann .grp').forEach(function(g){var its=g.querySelectorAll('.it');if(!its.length||g.dataset.bf)return;g.dataset.bf=1;[its[0],its[Math.floor(its.length/2)]].forEach(function(x){var t=document.createElement('span');t.className='it';t.textContent='Black Friday \u00b7 27\u201330 Nov: first-batch shipping priority on 3 jars';x.parentNode.insertBefore(t,x);});});};
    if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',sr);}else{sr();}}
  window.MV_BF=on;if(!on)return;
  document.documentElement.classList.add('mv-bf');
  function run(){
    document.querySelectorAll('.mv5-head .ann .it').forEach(function(e){e.textContent='Black Friday: 3 jars for the price of 2 \u2014 reserve by Monday for first-batch shipping priority.';});
    var h=document.querySelector('#mvpop .mvclub h3');if(h&&!document.querySelector('#mvpop .mvclub .ok'))h.textContent='Black Friday: 3 jars for the price of 2.';
  }
  if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',run);}else{run();}
})();
</script>
<style>.bfhero{display:none}.mv-bf-soon .bfhero.bfsoon,.mv-bf .bfhero.bfon{display:grid}
.bfhero{position:relative;grid-template-columns:auto 1fr auto;align-items:center;gap:14px;background:radial-gradient(120% 140% at 100% 0,#3d0f27 0,#120a0e 60%);color:#fff!important;border-radius:20px;padding:34px 16px 16px 18px;margin:0 0 16px;text-decoration:none!important;overflow:hidden;max-width:620px;box-shadow:0 12px 28px rgba(18,10,14,.28)}
.bfhero:before{content:"";position:absolute;inset:0;background:repeating-linear-gradient(135deg,rgba(255,255,255,.035) 0 2px,transparent 2px 9px);pointer-events:none}
.bfhero .bft{font-family:var(--display,'Inter Tight',Arial,sans-serif);font-weight:900;font-size:26px;line-height:.88;letter-spacing:-.04em;text-transform:uppercase;color:#fff;border-right:2px dashed rgba(255,216,77,.55);padding-right:14px}
.bfhero .bfm{display:flex;flex-direction:column;gap:2px;min-width:0}
.bfhero .bfm em{font-style:normal!important;font-size:11px!important;line-height:1.2!important;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#ffd84d}
.bfhero .bfm strong{font-family:var(--display,'Inter Tight',Arial,sans-serif);font-size:19px!important;font-weight:900;letter-spacing:-.02em;line-height:1.05;color:#fff}
.bfhero .bfm small{font-size:12.5px!important;line-height:1.3!important;color:rgba(255,255,255,.78)!important;margin:0!important}
.bfhero .bfj{display:flex;align-items:flex-end}.bfhero .bfj img{width:30px!important;max-width:none!important;height:auto!important;margin-left:-9px;filter:drop-shadow(0 4px 6px rgba(0,0,0,.4))}.bfhero .bfj img:nth-child(2){width:36px!important;position:relative;z-index:1}
.bfhero .bfc{position:absolute;top:-1px;right:16px;background:#ffd84d;color:#120a0e;font-size:11px;font-weight:800;letter-spacing:.04em;padding:5px 10px 6px;border-radius:0 0 10px 10px;text-transform:uppercase}
.bfhero .bfc b{font-weight:900}
@media (min-width:700px){.bfhero .bft{font-size:30px}.bfhero .bfm strong{font-size:22px!important}.bfhero .bfj img{width:38px!important}.bfhero .bfj img:nth-child(2){width:46px!important}}
.mv5 .bfonly{display:none!important}.mv-bf .mv5 .bfonly{display:block!important}.mv-bf .mv5 span.bfonly{display:inline-flex!important}</style>
<script>(function(){var S=Date.UTC(2026,10,27,0,1,0),E=Date.UTC(2026,10,30,23,59,59);function f(ms){if(ms<0)ms=0;var d=Math.floor(ms/864e5),h=Math.floor(ms%864e5/36e5),m=Math.floor(ms%36e5/6e4);return d>0?d+'d '+h+'h':h+'h '+m+'m';}
function t(){var n=Date.now();document.querySelectorAll('.bfsoon [data-bfc]').forEach(function(e){e.textContent=f(S-n)});document.querySelectorAll('.bfon [data-bfc]').forEach(function(e){e.textContent=f(E-n)});}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',t)}else{t()}setInterval(t,60000);})();</script>
