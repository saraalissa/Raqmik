{%- comment -%}
  No Drama Club waitlist pop-up. Opens after 18 seconds or 50% scroll, whichever comes first.
  Closed: hidden for 3 days. Joined: never shown again.
  Usage: {% render 'meva-club-pop' %}
{%- endcomment -%}
<div class="mvpop" id="mvpop" role="dialog" aria-modal="true" aria-labelledby="mvpop-t" hidden>
  <div class="mvpop-bg" data-pop-close></div>
  <div class="mvpop-card">
    <button class="mvpop-x" type="button" aria-label="Close" data-pop-close>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
    <div class="mvpop-img">
      <img src="{{ 'meva-day30.jpg' | file_img_url: '700x' }}" alt="A woman in sunglasses with a jar of Mëva" width="700" height="525" loading="lazy">
      <span class="mvpop-tag">No drama.</span>
    </div>
    <div class="mvpop-body">
      <span id="mvpop-t" class="mvpop-sr">Join the No Drama Club</span>
      {% render 'meva-club-form', fid: 'pop' %}
      <button class="mvpop-no" type="button" data-pop-close>Not now, thanks</button>
    </div>
  </div>
</div>
<style>
.mvpop[hidden]{display:none}
.mvpop{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:16px}
.mvpop-bg{position:absolute;inset:0;background:rgba(61,15,39,.55);backdrop-filter:blur(3px);opacity:0;transition:opacity .3s}
.mvpop-card{position:relative;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);width:100%;max-width:860px;max-height:calc(100vh - 32px);overflow:auto;background:#fbf7f4;border-radius:28px;box-shadow:0 30px 70px rgba(61,15,39,.35);transform:translateY(24px) scale(.98);opacity:0;transition:transform .35s cubic-bezier(.2,.8,.2,1),opacity .3s}
.mvpop.on .mvpop-bg{opacity:1}
.mvpop.on .mvpop-card{transform:none;opacity:1}
.mvpop-img{position:relative;min-height:100%}
.mvpop-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 30%;display:block}
.mvpop-tag{position:absolute;left:18px;bottom:18px;background:#ffd84d;color:#3d0f27;font-family:var(--display,'Inter Tight',Arial,sans-serif);font-weight:900;font-size:24px;letter-spacing:-.03em;line-height:1;padding:11px 16px 12px;border-radius:999px;transform:rotate(-3deg);box-shadow:0 8px 18px rgba(61,15,39,.2)}
.mvpop-body{padding:30px 28px 22px}
.mvpop-body .mvclub{border:0;padding:0;background:transparent;max-width:none}
.mvpop-x{position:absolute;top:12px;right:12px;z-index:2;width:40px;height:40px;border-radius:50%;border:0;background:#fff;color:#3d0f27;display:grid;place-items:center;cursor:pointer;box-shadow:0 4px 12px rgba(61,15,39,.15)}
.mvpop-no{display:block;margin:12px auto 0;background:none;border:0;color:rgba(61,15,39,.6);font:inherit;font-size:14px;font-weight:600;text-decoration:underline;cursor:pointer}
.mvpop-sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
html.mvpop-lock,html.mvpop-lock body{overflow:hidden}
@media (max-width:700px){
 .mvpop{align-items:flex-end;padding:0}
 .mvpop-card{grid-template-columns:1fr;border-radius:26px 26px 0 0;max-height:92vh;transform:translateY(100%)}
 .mvpop-img{height:auto;min-height:0}
 .mvpop-img img{position:static;width:100%;height:auto;aspect-ratio:4/3}
 .mvpop-body .mvclub .k{margin-bottom:4px}
 .mvpop-body .mvclub ul{gap:3px}
 .mvpop-body .mvclub li{font-size:15px}
 .mvpop-body .mvclub .f{margin-bottom:8px}
 .mvpop-body .mvclub input[type=email]{min-height:48px}
 .mvpop-tag{font-size:19px;left:14px;bottom:12px;padding:9px 14px 10px}
 .mvpop-body{padding:18px 18px 14px}
 .mvpop-body .mvclub ul{margin-bottom:14px}
 .mvpop-body .mvclub .fine{margin-top:8px;font-size:12px}
 .mvpop-no{margin-top:6px}
 .mvpop-body .mvclub h3{font-size:22px;margin-bottom:8px}
 .mvpop-body .mvclub .f:nth-of-type(2){display:none}
}
@media (prefers-reduced-motion:reduce){.mvpop-bg,.mvpop-card{transition:none}}
</style>
<script>
(function(){
  var p=document.getElementById('mvpop');if(!p)return;
  var K='mv_pop',now=Date.now(),st={};
  try{st=JSON.parse(localStorage.getItem(K)||'{}')}catch(e){}
  function save(o){try{localStorage.setItem(K,JSON.stringify(o))}catch(e){}}
  var last=null;
  function open(){last=document.activeElement;p.hidden=false;document.documentElement.classList.add('mvpop-lock');requestAnimationFrame(function(){p.classList.add('on')});var x=p.querySelector('.mvpop-x');if(x)x.focus({preventScroll:true});}
  function close(){p.classList.remove('on');document.documentElement.classList.remove('mvpop-lock');setTimeout(function(){p.hidden=true},300);if(!st.joined){st.closed=Date.now();save(st)}if(last&&last.focus)last.focus({preventScroll:true});}
  p.querySelectorAll('[data-pop-close]').forEach(function(b){b.addEventListener('click',close)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!p.hidden)close()});
  var f=p.querySelector('form');if(f)f.addEventListener('submit',function(){st.joined=1;save(st)});
  // Just joined through the pop-up: show the thank-you
  if(p.querySelector('.mvclub .ok')){st.joined=1;save(st);var nb=p.querySelector('.mvpop-no');if(nb)nb.textContent='Back to the site';open();return;}
  // Joined through another form on the page: never show
  if(document.querySelector('.mvclub .ok')){st.joined=1;save(st);return;}
  if(st.joined)return;
  if(st.closed&&now-st.closed<3*864e5)return;
  if(/\/(cart|checkouts?|account|policies)(\/|$)/.test(location.pathname))return;
  var shown=false;
  function go(){if(shown)return;shown=true;window.removeEventListener('scroll',onS);open();}
  function onS(){var d=document.documentElement,m=d.scrollHeight-window.innerHeight;if(m>0&&window.scrollY/m>=.5)go();}
  setTimeout(go,18000);
  window.addEventListener('scroll',onS,{passive:true});
})();
</script>
