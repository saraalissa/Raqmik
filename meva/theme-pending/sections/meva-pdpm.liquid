.mm .mm-stat{max-width:560px;margin:18px auto 0;border-top:1px solid rgba(255,255,255,.25);padding-top:16px}
.mm .mm-stat b{font-family:var(--display,'Inter Tight');font-size:46px;font-weight:900;color:var(--mm-butter);letter-spacing:-.04em}
.mm .mm-stat p{margin:4px 0 0;font-size:16px;line-height:1.5}
.mm .mm-stats .mm-src{color:#f3cfdc}
/* trust */
.mm .mm-trust{background:var(--mm-pink)}
.mm .mm-tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}
@media (min-width:900px){.mm .mm-tiles{grid-template-columns:repeat(4,1fr)}}
.mm .mm-tiles div{background:var(--mm-plum);color:#fff;border-radius:18px;padding:18px 14px;text-align:center;display:grid;gap:4px}
.mm .mm-tiles i{font-style:normal;font-family:var(--display,'Inter Tight');font-weight:900;font-size:24px;color:var(--mm-butter)}
.mm .mm-tiles b{font-size:15px}.mm .mm-tiles span{font-size:12.5px;opacity:.8}
/* cards */
.mm .mm-why .cards article,.mm .reasons article{flex:0 0 78%;max-width:340px;background:#fff;border-radius:20px;overflow:hidden;box-shadow:0 10px 26px rgba(61,15,39,.08)}
.mm .mm-why img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.mm .mm-why h3,.mm .reasons h3{font-size:20px;margin:14px 16px 6px}
.mm .mm-why p,.mm .reasons p{margin:0 16px 18px;font-size:14.5px;line-height:1.5;color:#5a3e4d}
.mm .reasons article{padding-top:16px}
.mm .reasons span{display:inline-block;margin:0 16px;background:var(--mm-berry);color:#fff;font-weight:900;font-size:13px;border-radius:999px;padding:4px 12px}
.mm .mm-rev{background:#fff;text-align:center}
/* day */
.mm .mm-day{background:var(--mm-plum)}
.mm .mm-day h2{color:#fff}.mm .mm-day .mm-lead{color:#f3cfdc}
.mm .mm-dgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:22px}
@media (min-width:900px){.mm .mm-dgrid{grid-template-columns:repeat(4,1fr)}}
.mm .mm-dgrid div{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);border-radius:18px;padding:16px 14px;color:#fff;display:grid;gap:6px;align-content:start}
.mm .mm-dgrid i{font-style:normal;justify-self:start;background:var(--mm-butter);color:var(--mm-plum);font-weight:900;font-size:11.5px;text-transform:uppercase;letter-spacing:.06em;padding:4px 9px;border-radius:999px}
.mm .mm-dgrid b{font-size:15.5px}.mm .mm-dgrid span{font-size:13px;line-height:1.45;color:#f3cfdc}
/* timeline */
.mm .mm-time ol{list-style:none;margin:24px auto 0;padding:0 0 0 18px;max-width:560px;border-left:3px solid var(--mm-butter)}
.mm .mm-time li{position:relative;padding:0 0 20px 20px}
.mm .mm-time li:before{content:"";position:absolute;left:-29px;top:2px;width:16px;height:16px;border-radius:50%;background:var(--mm-berry);box-shadow:0 0 0 4px var(--mm-cream)}
.mm .mm-time b{display:block;font-family:var(--display,'Inter Tight');font-weight:900;font-size:18px;color:var(--mm-berry)}
.mm .mm-time span{font-size:15.5px;line-height:1.55}
/* five */
.mm .mm-five{background:var(--mm-pink)}
/* vs */
.mm .mm-tbl{max-width:640px;margin:22px auto 0;border-radius:20px;overflow:hidden;background:#fff;box-shadow:0 10px 26px rgba(61,15,39,.08)}
.mm .mm-tbl>div{display:grid;grid-template-columns:.9fr 1.1fr 1fr;align-items:center;border-top:1px solid #f0e2dc}
.mm .mm-tbl>div>*{padding:13px 10px;font-size:13.5px;line-height:1.35}
.mm .mm-tbl .h{border-top:0}
.mm .mm-tbl .h b{text-align:center;font-family:var(--display,'Inter Tight');font-size:17px}
.mm .mm-tbl .h b:nth-child(2){background:var(--mm-plum);color:#fff}
.mm .mm-tbl span{font-weight:800}
.mm .mm-tbl i{font-style:normal;text-align:center}
.mm .mm-tbl i.y{background:#fdf1f5;font-weight:700}
.mm .mm-tbl i.y:before{content:"✓ ";color:var(--mm-berry);font-weight:900}
.mm .mm-tbl i.n{color:#8a7480}
.mm .mm-tbl i.n:before{content:"✕ ";color:#b9a3ae}
/* guarantee */
.mm .mm-guar{background:#fff;text-align:center}
.mm .mm-guar .mm-cta{max-width:420px;margin:22px auto 0}
.mm .mm-guar a{color:var(--mm-berry)}
.mm .mm-form .mm-w{display:flex;justify-content:center}
.mm .mm-faq h2{margin-bottom:18px}
.mm .mm-faq .mm-w{max-width:720px}
/* sticky */
.mm .mm-sbar{position:fixed;left:0;right:0;bottom:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:12px;background:#fff;border-top:1px solid #ecdcd6;padding:10px 16px calc(10px + env(safe-area-inset-bottom));transform:translateY(110%);transition:transform .25s}
.mm .mm-sbar.on{transform:none}
.mm .mm-sbar b{display:block;font-family:var(--display,'Inter Tight');font-size:20px}
.mm .mm-sbar small{font-size:12px;color:#7a5b6a}
.mm .mm-sbar .mm-cta{width:auto;margin:0;padding:14px 22px;font-size:15.5px}
@keyframes mmflash{0%{box-shadow:0 0 0 0 rgba(142,42,90,.55)}100%{box-shadow:0 0 0 18px rgba(142,42,90,0)}}
.mm .mvclub.mm-flash{animation:mmflash 1.1s ease-out 2}
</style>
<script>
(function(){
  var root=document.querySelector('.mm');if(!root)return;
  var st=document.getElementById('mm-stage'),th=document.querySelectorAll('#mm-thumbs button');
  th.forEach(function(b,i){b.addEventListener('click',function(){st.scrollTo({left:st.clientWidth*i,behavior:'smooth'});});});
  if(st)st.addEventListener('scroll',function(){var i=Math.round(st.scrollLeft/st.clientWidth);th.forEach(function(b,k){b.setAttribute('aria-pressed',k===i?'true':'false');});},{passive:true});
  var PR={1:['{{ v1.price | money }}','1 jar · + {{ del1 }} delivery'],2:['{{ v2.price | money }}','2 jars · free UK delivery'],3:['{{ v3.price | money }}','3 jars · free UK delivery']};
  function pack(){var r=root.querySelector('input[name=mm-pack]:checked');return r?r.value:'2';}
  root.querySelectorAll('input[name=mm-pack]').forEach(function(r){r.addEventListener('change',function(){var x=PR[r.value];document.getElementById('mm-sbp').textContent=x[0];document.getElementById('mm-sbn').textContent=x[1];});});
  function go(){
    var pk=pack(),club=document.getElementById('club'),cf=club&&club.querySelector('form');if(!cf)return;
    var pkf=cf.querySelector('[data-club-pack]');if(pkf){pkf.hidden=false;var ri=pkf.querySelector('input[value="'+pk+'"]');if(ri)ri.checked=true;}
    var h3=cf.querySelector('h3');if(h3)h3.textContent='Save your pack. Pay nothing today.';
    try{var u=new URL(location.href);u.searchParams.set('reserve',pk);history.replaceState(null,'',u.toString());}catch(e){}
    club.scrollIntoView({behavior:'smooth',block:'start'});
    var em=cf.querySelector('input[type=email]');if(em)setTimeout(function(){em.focus({preventScroll:true});},650);
    club.classList.remove('mm-flash');void club.offsetWidth;club.classList.add('mm-flash');
  }
  root.querySelectorAll('[data-mm-reserve]').forEach(function(b){b.addEventListener('click',go);});
  var sb=root.querySelector('.mm-sbar'),buy=document.getElementById('mm-buy'),form=document.getElementById('club');
  function sbar(){var bb=buy.getBoundingClientRect(),fb=form?form.getBoundingClientRect():{top:9e9,bottom:-1};var past=bb.bottom<0,atForm=fb.top<innerHeight&&fb.bottom>0;sb.classList.toggle('on',past&&!atForm);}
  window.addEventListener('scroll',sbar,{passive:true});sbar();
  if(/(^|[?&])customer_posted=true/.test(location.search)&&form)form.scrollIntoView();
})();
</script>
{% schema %}
{
  "name": "Mëva product (long-form)",
  "settings": [
    { "type": "text", "id": "single_delivery", "label": "Delivery price for 1 jar", "default": "£4.99" },
    { "type": "text", "id": "dose_text", "label": "Dose text", "default": "Adults: chew two gummies a day. Do not exceed the stated dose. Not recommended during pregnancy or breastfeeding unless advised by a healthcare professional." },
    { "type": "textarea", "id": "ingredients", "label": "Ingredients", "default": "Glucose syrup, sugar, magnesium citrate, water, pectin (gelling agent), citric acid (acid), trisodium citrate (acidity regulator), spirulina, anthocyanins (colour), coconut oil, natural flavouring, carnauba wax (glazing agent). Made without the 14 major allergens." }
  ]
}
{% endschema %}
