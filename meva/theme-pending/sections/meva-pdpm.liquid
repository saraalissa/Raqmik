{%- comment -%}
  Mëva product page, long-form DTC layout (18 Nov). Preview with ?view=m on the product URL.
  Waitlist mode: no checkout. "Reserve mine" scrolls to the club form with the chosen pack.
  No invented stats, reviews or stock warnings. Claims are the UK-authorised wording only.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank
    assign p = all_products['meva-magnesium-gummies']
  endif
  assign v1 = p.variants.first
  assign v2 = p.variants.first
  assign v3 = p.variants.first
  for v in p.variants
    if v.title contains '3'
      assign v3 = v
    elsif v.title contains '2'
      assign v2 = v
    else
      assign v1 = v
    endif
  endfor
  assign pd1 = v1.price | times: 1.0 | divided_by: 30 | round
  assign pd2 = v2.price | times: 1.0 | divided_by: 60 | round
  assign pd3 = v3.price | times: 1.0 | divided_by: 90 | round
  assign pj2 = v2.price | divided_by: 2
  assign pj3 = v3.price | divided_by: 3
  assign was2 = v1.price | times: 2
  assign was3 = v1.price | times: 3
  assign sv2 = was2 | minus: v2.price
  assign sv3 = was3 | minus: v3.price
  assign del1 = section.settings.single_delivery
-%}
<div class="mv5 mm">

  {%- comment -%} 1. Gallery {%- endcomment -%}
  <section class="mm-top"><div class="mm-w">
    <div class="mm-gal">
      <div class="mm-stage" id="mm-stage">
        {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
        <div class="mm-slide">{{ m | image_url: width: 1100 | image_tag: alt: m.alt, loading: 'eager', sizes: '(max-width: 900px) 100vw, 50vw', widths: '550, 800, 1100' }}</div>
        {%- endif -%}{%- endfor -%}
      </div>
      <div class="mm-thumbs" id="mm-thumbs">
        {%- for m in p.media -%}{%- if m.media_type == 'image' -%}
        <button type="button" aria-label="Photo {{ forloop.index }}"{% if forloop.first %} aria-pressed="true"{% endif %}>{{ m | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}</button>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>

    {%- comment -%} 2. Buy box {%- endcomment -%}
    <div class="mm-buy" id="mm-buy">
      <p class="mm-proof"><span class="mm-dot"></span>Founding 500 open · launching January</p>
      <h1>Mëva Magnesium<br>Berry Gummies</h1>
      <p class="mm-sub">180mg magnesium in two berry gummies a day. The dose, printed on the front.</p>
      <ul class="mm-cks">
        <li>Contributes to a reduction of tiredness and fatigue</li>
        <li>Contributes to normal psychological function</li>
        <li>Contributes to normal muscle function</li>
      </ul>
      <div class="mm-price"><b>From {{ pj3 | money }}</b><span>a jar</span><em>Black Friday: 3 jars for the price of 2</em></div>

      <p class="mm-lab">Choose your pack</p>
      <div class="mm-packs" role="radiogroup" aria-label="Choose your pack">
        <label class="mm-pk"><input type="radio" name="mm-pack" value="1"><span class="mm-pkimg"><img src="{{ 'packjar1.png' | file_url }}" alt="" width="120" height="84" loading="lazy"></span><span class="mm-pkt"><b>1 jar</b><small>30 days · + {{ del1 }} delivery</small></span><span class="mm-pkp"><b>{{ v1.price | money }}</b><small>{{ pd1 | money }} a day</small></span></label>
        <label class="mm-pk"><span class="mm-flag">Most popular</span><input type="radio" name="mm-pack" value="2" checked><span class="mm-pkimg"><img src="{{ 'packjar2.png' | file_url }}" alt="" width="120" height="84" loading="lazy"></span><span class="mm-pkt"><b>2 jars</b><small>60 days · free UK delivery</small></span><span class="mm-pkp"><b>{{ v2.price | money }}</b><em class="mm-save">Save {{ sv2 | money }} vs single jars</em><small>{{ pd2 | money }} a day</small></span></label>
        <label class="mm-pk"><span class="mm-flag y">Best value</span><input type="radio" name="mm-pack" value="3"><span class="mm-pkimg"><img src="{{ 'packjar3.png' | file_url }}" alt="" width="120" height="84" loading="lazy"></span><span class="mm-pkt"><b>3 jars</b><small>90 days · free UK delivery</small></span><span class="mm-pkp"><b>{{ v3.price | money }}</b><em class="mm-save">Save {{ sv3 | money }} vs single jars</em><small>{{ pd3 | money }} a day</small></span></label>
      </div>
      <button type="button" class="mm-cta" data-mm-reserve>Reserve mine <span>· nothing to pay today</span></button>
      <p class="mm-under">Founding 500: 20% off a single jar on your first order. Offers don&#39;t stack.</p>

      <div class="mm-gbar"><span class="mm-seal">1st<br>jar</span><p><b>First-jar guarantee.</b> Finish your first jar. Not for you? We&#39;ll refund it.</p></div>

      <div class="mm-acc">
        <details open><summary>What it does</summary><ul class="mm-cl">
          <li>Magnesium contributes to a reduction of tiredness and fatigue.</li>
          <li>Magnesium contributes to normal psychological function.</li>
          <li>Magnesium contributes to the normal functioning of the nervous system.</li>
          <li>Magnesium contributes to normal muscle function.</li>
          <li>Magnesium contributes to the maintenance of normal bones.</li>
        </ul><p class="mm-fine">The UK-authorised claims, word for word. Nothing added.</p></details>
        <details><summary>What&#39;s inside</summary><p>{{ section.settings.ingredients }}</p><p class="mm-fine">90mg magnesium (citrate) per gummy. Two gummies give 180mg, 48% of the daily reference intake.</p></details>
        <details><summary>How to take it</summary><p>{{ section.settings.dose_text }}</p></details>
      </div>
    </div>
  </div></section>

  {%- comment -%} 3. Meet the club {%- endcomment -%}
  <section class="mm-sec mm-club"><div class="mm-w">
    <h2>Meet the club</h2><p class="mm-lead">Grey streaks welcome. Drama not included.</p>
    <div class="mm-rail">
      {%- for i in (1..4) -%}<figure><img src="{{ 'meva-studio-' | append: i | append: '.jpg' | file_img_url: '700x' }}" alt="Woman in her fifties holding a jar of Mëva magnesium berry gummies" loading="lazy" width="700" height="875"></figure>{%- endfor -%}
    </div>
  </div></section>

  {%- comment -%} 4. Numbers (real, sourced) {%- endcomment -%}
  <section class="mm-sec mm-stats"><div class="mm-w">
    <h2>Why magnesium, and why now</h2>
    <div class="mm-stat"><b>83%</b><p>The average UK woman gets about 83% of her recommended magnesium from food.</p></div>
    <div class="mm-stat"><b>15%</b><p>of women aged 19 to 64 don&#39;t reach even the minimum from food alone.</p></div>
    <div class="mm-stat"><b>48%</b><p>of your daily reference intake, in two berry gummies. That&#39;s the gap, covered.</p></div>
    <p class="mm-src">Source: National Diet and Nutrition Survey 2019&ndash;2023, OHID &amp; Food Standards Agency (2025).</p>
    <button type="button" class="mm-cta light" data-mm-reserve>Reserve mine</button>
  </div></section>

  {%- comment -%} 5. Why trust {%- endcomment -%}
  <section class="mm-sec mm-trust"><div class="mm-w">
    <h2>Why trust Mëva</h2>
    <div class="mm-tiles">
      <div><i>180</i><b>Dose on the front</b><span>Readable from the kettle</span></div>
      <div><i>UK</i><b>Authorised claims only</b><span>Word for word</span></div>
      <div><i>V</i><b>Vegan &amp; gelatine-free</b><span>Plant pectin gummy</span></div>
      <div><i>1×</i><b>One-off orders</b><span>No subscription, ever</span></div>
    </div>
  </div></section>

  {%- comment -%} 6. Why this gummy works {%- endcomment -%}
  <section class="mm-sec mm-why"><div class="mm-w">
    <h2>Why this gummy makes sense</h2>
    <div class="mm-rail cards">
      <article><img src="{{ 'meva-g3-04.jpg' | file_img_url: '700x' }}" alt="Glossy magenta Mëva gummy next to blackberries" loading="lazy" width="700" height="700"><h3>One form, named</h3><p>Magnesium citrate. One mineral, the exact amount on the label. No long blend to decode.</p></article>
      <article><img src="{{ 'meva-ad-A4-feed.jpg' | file_img_url: '700x' }}" alt="Jar of Mëva with the dose circled: 180mg magnesium, 2 a day" loading="lazy" width="700" height="875"><h3>180mg you can read</h3><p>Two gummies give 180mg, 48% of your daily reference intake. Printed big, on the front.</p></article>
      <article><img src="{{ 'meva-g3-06b.jpg' | file_img_url: '700x' }}" alt="Two Mëva gummies compared with a handful of tablets" loading="lazy" width="700" height="700"><h3>No water, no swallowing</h3><p>A ripe red berry gummy you chew in four seconds. The supplement you actually remember.</p></article>
    </div>
  </div></section>

  {%- comment -%} 7. Reviews, honestly {%- endcomment -%}
  <section class="mm-sec mm-rev"><div class="mm-w">
    <p class="mm-k">Reviews</p><h2>No reviews yet. That&#39;s honest.</h2>
    <p class="mm-lead">We launch in January. The Founding 500 will write the first ones, and we&#39;ll never edit, hide or pay for them.</p>
    <div class="jdgm-widget jdgm-review-widget" data-id="{{ p.id }}">{{ p.metafields.judgeme.widget }}</div>
  </div></section>

  {%- comment -%} 8. Where it shows up in your day {%- endcomment -%}
  <section class="mm-sec mm-day"><div class="mm-w">
    <h2>Where it shows up in your day</h2><p class="mm-lead">The moment, then the authorised claim, word for word.</p>
    <div class="mm-dgrid">
      <div><i>3pm</i><b>The afternoon slump</b><span>Magnesium contributes to a reduction of tiredness and fatigue.</span></div>
      <div><i>Head</i><b>Holding everyone&#39;s diary</b><span>Magnesium contributes to normal psychological function.</span></div>
      <div><i>Nerves</i><b>Days at full volume</b><span>Magnesium contributes to the normal functioning of the nervous system.</span></div>
      <div><i>Body</i><b>Stairs, shopping, the walk</b><span>Magnesium contributes to normal muscle function.</span></div>
    </div>
    <button type="button" class="mm-cta light" data-mm-reserve>Reserve mine</button>
  </div></section>

  {%- comment -%} 9. First 30 days (routine, not results) {%- endcomment -%}
  <section class="mm-sec mm-time"><div class="mm-w">
    <h2>Your first jar, day by day</h2><p class="mm-lead">A routine, not a promise of results.</p>
    <ol>
      <li><b>Day 1</b><span>The jar goes by the kettle. Two gummies, four seconds, done before anyone asks for anything.</span></li>
      <li><b>Day 7</b><span>You stop thinking about it. Kettle on, gummies, the way you&#39;d brush your teeth.</span></li>
      <li><b>Day 14</b><span>Halfway. 28 gummies in. The jar lives in your bag on busy days.</span></li>
      <li><b>Day 30</b><span>A jar you actually finished. Honest check-in: keep going, or we refund your first jar.</span></li>
    </ol>
  </div></section>

  {%- comment -%} 10. Five reasons {%- endcomment -%}
  <section class="mm-sec mm-five"><div class="mm-w">
    <p class="mm-k">5 reasons</p><h2>Why Mëva is different from what you&#39;ve tried</h2>
    <div class="mm-rail reasons">
      <article><span>1</span><h3>The dose is on the front</h3><p>180mg magnesium, 2 a day. No hunting through tiny print.</p></article>
      <article><span>2</span><h3>Claims you can check</h3><p>Only the UK-authorised wording. If we can&#39;t prove it, we don&#39;t say it.</p></article>
      <article><span>3</span><h3>A gummy you look forward to</h3><p>Ripe red berry, soft and glossy. Never chalky.</p></article>
      <article><span>4</span><h3>No subscription trap</h3><p>Every order is one-off. Nothing renews.</p></article>
      <article><span>5</span><h3>First-jar guarantee</h3><p>Finish your first jar. Not for you? We&#39;ll refund it.</p></article>
    </div>
  </div></section>

  {%- comment -%} 11. Comparison {%- endcomment -%}
  <section class="mm-sec mm-vs"><div class="mm-w">
    <h2>Mëva vs the usual wellness hype</h2><p class="mm-lead">Comparing claims, labels and format. Not a medical comparison, and not about any one brand.</p>
    <div class="mm-tbl">
      <div class="h"><span></span><b>mëva</b><b>The usual</b></div>
      <div><span>Claims</span><i class="y">UK-authorised, word for word</i><i class="n">Big promises</i></div>
      <div><span>Label</span><i class="y">180mg on the front</i><i class="n">Long blends, tiny print</i></div>
      <div><span>Format</span><i class="y">Berry gummy, no water</i><i class="n">Large tablets</i></div>
      <div><span>Subscription</span><i class="y">Never</i><i class="n">Often hard to cancel</i></div>
      <div><span>Guarantee</span><i class="y">First jar refunded</i><i class="n">Unopened packs only</i></div>
    </div>
  </div></section>

  {%- comment -%} 12. Guarantee {%- endcomment -%}
  <section class="mm-sec mm-guar"><div class="mm-w">
    <span class="mm-seal big">First<br>jar</span>
    <p class="mm-k">The first-jar guarantee</p>
    <h2>Finish your first jar. Not for you? We&#39;ll refund it.</h2>
    <p class="mm-lead">Claim within 45 days of delivery. First order only, one per household. <a href="{{ routes.root_url }}pages/refunds">Full terms</a>.</p>
    <button type="button" class="mm-cta" data-mm-reserve>Reserve mine</button>
  </div></section>

  {%- comment -%} 13. Club form {%- endcomment -%}
  <section class="mm-sec mm-form"><div class="mm-w">{% render 'meva-club-form', fid: 'club' %}</div></section>

  {%- comment -%} 14. FAQ {%- endcomment -%}
  <section class="mm-sec mm-faq"><div class="mm-w">
    <h2>Frequently asked questions</h2>
    <details><summary>How many gummies do I take?</summary><p>{{ section.settings.dose_text }}</p></details>
    <details><summary>What do they taste like?</summary><p>Ripe red berry. Soft, chewy and glossy, never chalky.</p></details>
    <details><summary>How long until I notice a difference?</summary><p>Everyone&#39;s different, so we won&#39;t promise results. Give it a full jar as part of your daily routine. If it isn&#39;t for you, the first-jar guarantee has you covered.</p></details>
    <details><summary>Can I take it alongside HRT or other medication?</summary><p>Please check with your GP or pharmacist before taking any supplement alongside medication.</p></details>
    <details><summary>Do I have to subscribe?</summary><p>No. Every order is a one-off purchase. Nothing renews automatically.</p></details>
    <details><summary>When do you launch?</summary><p>January. Reserve now and the Founding 500 hear first. Nothing to pay today.</p></details>
    <details><summary>Is there sugar in it?</summary><p>Yes, it&#39;s a gummy, so there&#39;s glucose syrup and sugar. The full list is under &ldquo;What&#39;s inside&rdquo;.</p></details>
  </div></section>

  <div class="mm-sbar"><div><b id="mm-sbp">{{ v2.price | money }}</b><small id="mm-sbn">2 jars · free UK delivery</small></div><button type="button" class="mm-cta" data-mm-reserve>Reserve mine</button></div>
</div>

<style>
.mm{--mm-plum:#3d0f27;--mm-berry:#8e2a5a;--mm-pink:#f7c9d6;--mm-cream:#fbf5f1;--mm-butter:#ffd84d;background:var(--mm-cream);color:var(--mm-plum);padding-bottom:84px}
.mm .mm-w{max-width:1120px;margin:0 auto;padding:0 18px}
.mm h1,.mm h2,.mm h3{font-family:var(--display,'Inter Tight',sans-serif);letter-spacing:-.035em;color:var(--mm-plum);margin:0}
.mm h2{font-size:clamp(27px,4vw,40px);line-height:1.05;text-align:center}
.mm .mm-lead{text-align:center;font-size:16px;line-height:1.55;color:#6b4a5b;margin:10px auto 0;max-width:560px}
.mm .mm-k{text-align:center;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--mm-berry);margin:0 0 8px}
.mm .mm-sec{padding:clamp(40px,7vw,80px) 0}
.mm .mm-fine,.mm .mm-src{font-size:12.5px;color:#8a6b7a;margin:8px 0 0}
.mm .mm-src{text-align:center}
/* top */
.mm .mm-top{padding:10px 0 30px}
.mm .mm-top .mm-w{display:grid;gap:22px;grid-template-columns:minmax(0,1fr)}
.mm .mm-top .mm-w>*{min-width:0}
.mm{overflow-x:clip}
@media (min-width:900px){.mm .mm-top .mm-w{grid-template-columns:1.05fr 1fr;align-items:start;gap:44px}.mm .mm-gal{position:sticky;top:90px}}
.mm .mm-stage{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;border-radius:22px;background:#fff;scrollbar-width:none}
.mm .mm-stage::-webkit-scrollbar{display:none}
.mm .mm-slide{flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1/1}
.mm .mm-slide img{width:100%;height:100%;object-fit:cover;display:block}
.mm .mm-thumbs{display:flex;gap:8px;margin-top:10px;overflow-x:auto;scrollbar-width:none}
.mm .mm-thumbs button{flex:0 0 64px;height:64px;border-radius:12px;overflow:hidden;border:2px solid transparent;padding:0;background:#fff;cursor:pointer}
