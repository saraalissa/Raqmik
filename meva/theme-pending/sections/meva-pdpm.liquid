.mx-cols h3{font-family:Poppins;font-weight:400;font-size:17px;padding:4px 0 12px;color:inherit}
.mx-cols .us h3{color:#fff}
.mx-cols p{margin:0;min-height:72px;display:grid;place-items:center;align-content:center;gap:4px;border-top:1px solid rgba(0,0,0,.08);font-size:12.5px;padding:8px}
.mx-cols .us p{border-color:rgba(255,255,255,.2);color:#fff}
.mx-cols i{font-style:normal;width:20px;height:20px;border-radius:50%;display:grid;place-items:center;font-size:11px;background:#fff;color:var(--a2);font-weight:800}
.mx-cols .them i{background:#555;color:#fff}
/* guarantee */
.mx-guar{text-align:center;padding-bottom:0}
.mx-bigseal{width:130px;height:130px;margin:0 auto;border-radius:50%;background:var(--a2);color:#fff;display:grid;place-items:center;align-content:center;font-family:Poppins;box-shadow:0 0 0 5px var(--pe),0 0 0 8px var(--a2)}
.mx-bigseal b{font-size:34px;line-height:1}.mx-bigseal span{font-size:16px}.mx-bigseal small{font-size:11px;text-transform:uppercase;letter-spacing:1px;color:#ffe08a}
.mx-guar a{color:var(--a)}
.mx-gwoman{display:block;width:80%;max-width:360px;margin:26px auto 0;border-radius:180px 180px 0 0}
/* faq */
.mx-faqh{text-align:center;font-family:Poppins;font-weight:600;font-size:26px;text-transform:uppercase;letter-spacing:2px;color:var(--ink);line-height:1.15}
.mx-faq{margin-top:22px;display:grid;gap:12px}
.mx-faq details{background:#f6f2f3;border-radius:10px}
.mx-faq summary{list-style:none;cursor:pointer;padding:18px 44px 18px 18px;font-size:14.5px;color:var(--ink);position:relative;line-height:1.4}
.mx-faq summary:after{content:"⌄";position:absolute;right:18px;top:14px;font-size:18px}
.mx-faq p{margin:0;padding:0 18px 18px;font-size:14px;line-height:1.55}
/* sticky + sheet */
.mx-sticky{position:fixed;left:0;right:0;bottom:0;z-index:60;display:flex;align-items:center;gap:10px;background:#fff;padding:10px 12px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -4px 16px rgba(0,0,0,.08);transform:translateY(120%);transition:transform .25s}
.mx-sticky.on{transform:none}
.mx-sticky img{width:40px;height:auto}.mx-sticky div{flex:1;min-width:0}.mx-sticky b{display:block;font-weight:500;font-size:13px;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.mx-sticky span{color:var(--a);font-weight:700}
.mx-sticky button{border:0;border-radius:6px;background:var(--a);color:#fff;font-weight:700;padding:13px 16px;font-size:14px;letter-spacing:.5px;cursor:pointer}
.mx-sheet{position:fixed;inset:0;z-index:80;display:flex;align-items:flex-end;justify-content:center}
.mx-sheet[hidden]{display:none}
.mx-sbg{position:absolute;inset:0;background:rgba(20,10,15,.5)}
.mx-sbox{position:relative;width:100%;max-width:560px;max-height:92vh;overflow:auto;background:#fff;border-radius:18px 18px 0 0;padding:14px 10px 20px;animation:mxup .25s ease-out}
@media (min-width:700px){.mx-sheet{align-items:center}.mx-sbox{border-radius:18px}}
@keyframes mxup{from{transform:translateY(40px);opacity:0}}
.mx-x{position:absolute;right:10px;top:8px;width:34px;height:34px;border:0;border-radius:50%;background:#f3eef0;font-size:22px;cursor:pointer;z-index:2}
.mx-sbox .mvclub{border:0;max-width:none;padding:18px 14px}
html.mx-lock{overflow:hidden}
</style>
<script>
(function(){
  var R=document.querySelector('.mx');if(!R)return;
  var CD=document.getElementById('mx-cd');if(CD){CD.classList.add('mx-cd-top');document.body.insertBefore(CD,document.body.firstChild);}
  var P={1:['{{ v1.price | money }}',''],2:['{{ v2.price | money }}','{{ was2 | money }}'],3:['{{ v3.price | money }}','{{ was3 | money }}']};
  function pack(){var r=R.querySelector('input[name=mx-pack]:checked');return r?r.value:'2';}
  R.querySelectorAll('input[name=mx-pack]').forEach(function(r){r.addEventListener('change',function(){var x=P[r.value];R.querySelectorAll('[data-mx-price]').forEach(function(e){e.textContent=x[0];});R.querySelectorAll('[data-mx-was]').forEach(function(e){e.textContent=x[1];});});});
  /* gallery */
  var st=document.getElementById('mx-stage'),th=R.querySelectorAll('#mx-thumbs button');
  function go(i){var n=st.querySelectorAll('.mx-slide').length;i=(i+n)%n;st.scrollTo({left:st.clientWidth*i,behavior:'smooth'});}
  function cur(){return Math.round(st.scrollLeft/st.clientWidth);}
  th.forEach(function(b,i){b.addEventListener('click',function(){go(i);});});
  R.querySelector('[data-mx-prev]').addEventListener('click',function(){go(cur()-1);});
  R.querySelector('[data-mx-next]').addEventListener('click',function(){go(cur()+1);});
  st.addEventListener('scroll',function(){var i=cur();th.forEach(function(b,k){b.setAttribute('aria-pressed',k===i?'true':'false');});},{passive:true});
  /* carousels */
  R.querySelectorAll('[data-mx-car]').forEach(function(c){var nav=c.nextElementSibling,dots=nav.querySelector('.mx-dots'),items=c.children,n=items.length;
    for(var i=0;i<n;i++){dots.appendChild(document.createElement('i'));}
    function idx(){var w=items[0].offsetWidth+14;return Math.min(n-1,Math.round(c.scrollLeft/w));}
    function mark(){var k=idx();dots.querySelectorAll('i').forEach(function(d,j){d.className=j===k?'on':'';});}
    function to(k){k=Math.max(0,Math.min(n-1,k));c.scrollTo({left:items[k].offsetLeft-c.offsetLeft-16,behavior:'smooth'});}
    nav.querySelector('[data-p]').addEventListener('click',function(){to(idx()-1);});nav.querySelector('[data-n]').addEventListener('click',function(){to(idx()+1);});
    c.addEventListener('scroll',mark,{passive:true});mark();});
  /* countdown */
  var cd=document.querySelector('[data-mx-cd]');if(cd){var T=new Date(cd.getAttribute('data-mx-cd')).getTime(),b=cd.querySelectorAll('b');
    function tick(){var d=Math.max(0,T-Date.now()),s=Math.floor(d/1000),v=[Math.floor(s/86400),Math.floor(s%86400/3600),Math.floor(s%3600/60),s%60];b.forEach(function(e,i){e.textContent=String(v[i]).padStart(2,'0');});}
    tick();setInterval(tick,1000);}
  /* reserve sheet */
  var sh=document.getElementById('mx-sheet');
  function open(){var cf=sh.querySelector('form');if(cf){var pk=pack(),pkf=cf.querySelector('[data-club-pack]');if(pkf){pkf.hidden=false;var ri=pkf.querySelector('input[value="'+pk+'"]');if(ri)ri.checked=true;}var h=cf.querySelector('h3');if(h)h.textContent='Save your pack. Pay nothing today.';try{var u=new URL(location.href);u.searchParams.set('reserve',pk);history.replaceState(null,'',u.toString());}catch(e){}}
    sh.hidden=false;document.documentElement.classList.add('mx-lock');var em=sh.querySelector('input[type=email]');if(em)setTimeout(function(){em.focus();},280);}
  function close(){sh.hidden=true;document.documentElement.classList.remove('mx-lock');}
  R.querySelectorAll('[data-mx-reserve]').forEach(function(b){b.addEventListener('click',open);});
  sh.querySelectorAll('[data-mx-close]').forEach(function(b){b.addEventListener('click',close);});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!sh.hidden)close();});
  if(sh.querySelector('.mvclub .ok')||sh.querySelector('.mvclub .err'))open();
  /* sticky */
  var sk=document.getElementById('mx-sticky'),atc=R.querySelector('.mx-atc');
  function sb(){sk.classList.toggle('on',atc.getBoundingClientRect().bottom<0);}
  window.addEventListener('scroll',sb,{passive:true});sb();
})();
</script>
{% schema %}
{
  "name": "Mëva product (long-form)",
  "settings": [
    { "type": "number", "id": "founding_count", "label": "Founding spots reserved (real number, update daily)", "default": 24 },
    { "type": "number", "id": "founding_total", "label": "Founding spots total", "default": 500 },
    { "type": "text", "id": "single_delivery", "label": "Delivery price for 1 jar", "default": "£4.99" },
    { "type": "text", "id": "dose_text", "label": "Dose text", "default": "Adults: chew two gummies a day. Do not exceed the stated dose. Not recommended during pregnancy or breastfeeding unless advised by a healthcare professional." },
    { "type": "textarea", "id": "ingredients", "label": "Ingredients", "default": "Glucose syrup, sugar, magnesium citrate, water, pectin (gelling agent), citric acid (acid), trisodium citrate (acidity regulator), spirulina, anthocyanins (colour), coconut oil, natural flavouring, carnauba wax (glazing agent). Made without the 14 major allergens." }
  ]
}
{% endschema %}
