{%- comment -%}
  Mëva product page v2 (18 Nov). Same section order and design system as a high-converting US long-form PDP,
  with Mëva content. Preview: product URL + ?view=m. Waitlist mode: "Reserve" opens a sheet with the club form.
  Honest rules: no invented reviews, ratings, stats or stock levels. Claims are UK-authorised wording only.
{%- endcomment -%}
{%- liquid
  assign p = product
  if p == blank
    assign p = all_products['meva-magnesium-gummies']
  endif
  assign v1 = p.variants.first
  assign v2 = p.variants.first
  assign v3 = p.variants.first
  for v in p.variants
    if v.title contains '3'
      assign v3 = v
    elsif v.title contains '2'
      assign v2 = v
    else
      assign v1 = v
    endif
  endfor
  assign was2 = v1.price | times: 2
  assign was3 = v1.price | times: 3
  assign sv2 = was2 | minus: v2.price
  assign sv3 = was3 | minus: v3.price
  assign svp2 = sv2 | times: 100 | divided_by: was2
  assign svp3 = sv3 | times: 100 | divided_by: was3
  assign pj3 = v3.price | divided_by: 3
  assign del1 = section.settings.single_delivery
  assign fc = section.settings.founding_count | default: 0
  assign ft = section.settings.founding_total | default: 500
  assign fpct = fc | times: 100 | divided_by: ft
  assign fbar = fpct
  if fbar < 4
    assign fbar = 4
  endif
  assign jar = 'meva-jar-cut.png' | file_img_url: '600x'
-%}
