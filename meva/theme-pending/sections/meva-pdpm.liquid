.mx h1,.mx h2,.mx h3,.mx .mx-h{font-family:Poppins,sans-serif;color:var(--ink);margin:0;letter-spacing:.3px}
.mx .mx-w{max-width:1100px;margin:0 auto;padding:0 16px}
.mx .mx-w.n{max-width:640px}
.mx em{font-style:normal;color:var(--a)}
/* countdown + marquee */
.mx-cd{display:flex;align-items:center;justify-content:space-between;gap:10px;background:var(--a2);color:#fff;padding:8px 14px}
.mx-cd b{display:block;font-family:Poppins;font-weight:600;font-size:15px;text-transform:uppercase;letter-spacing:.6px}
.mx-cd span{font-size:11.5px;opacity:.9}
.mx-timer{display:flex;gap:6px}.mx-timer span{display:grid;text-align:center;font-size:9px;opacity:1}.mx-timer b{font-size:16px;letter-spacing:0}
.mx-marq{background:var(--a);color:#fff;overflow:hidden;white-space:nowrap;font-size:12.5px;font-weight:600;padding:7px 0}
.mx-marq>div{display:inline-block;animation:mxm 26s linear infinite}.mx-marq span{margin:0 18px}
@keyframes mxm{to{transform:translateX(-50%)}}
/* main */
.mx-main{padding:0 0 26px}
.mx-main .mx-w{display:grid;grid-template-columns:minmax(0,1fr);gap:14px;padding:0}
.mx-main .mx-w>*{min-width:0}
@media (min-width:900px){.mx-main .mx-w{grid-template-columns:1.1fr 1fr;gap:40px;padding:20px 16px}.mx-gal{position:sticky;top:80px;align-self:start}}
.mx-stage{position:relative;display:flex;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;background:#f4eff0}
.mx-stage::-webkit-scrollbar{display:none}
.mx-slide{position:relative;flex:0 0 100%;scroll-snap-align:start;aspect-ratio:1/1}
.mx-slide img{width:100%;height:100%;object-fit:cover;display:block}
.mx-free{position:absolute;left:10px;top:10px;max-width:62%;background:var(--a);color:#fff;font-family:Poppins;font-weight:600;font-size:12px;line-height:1.25;padding:8px 12px;border-radius:8px;text-transform:uppercase}
.mx-free b{display:block;color:#ffe08a}
.mx-seal90{position:absolute;right:10px;top:10px;width:64px;height:64px;border-radius:50%;background:#fff;border:3px solid var(--a);color:var(--a);display:grid;place-items:center;text-align:center;font-family:Poppins;font-weight:600;font-size:11px;line-height:1.05;text-transform:uppercase}
.mx-seal90 small{font-size:7px}
.mx-arr{position:sticky;top:50%;flex:0 0 34px;height:34px;margin-left:-34px;align-self:center;border:0;border-radius:50%;background:rgba(255,255,255,.9);font-size:20px;cursor:pointer;z-index:2;box-shadow:0 2px 8px rgba(0,0,0,.12)}
.mx-arr.l{order:-1;left:8px;margin:0 -34px 0 8px}.mx-arr.r{right:8px}
.mx-thumbs{display:flex;gap:8px;padding:8px 12px;overflow-x:auto;scrollbar-width:none}
.mx-thumbs button{flex:0 0 26%;aspect-ratio:1/1;border:2px solid transparent;border-radius:6px;padding:0;overflow:hidden;background:#f4eff0;cursor:pointer}
.mx-thumbs button[aria-pressed=true]{border-color:var(--a)}
.mx-thumbs img{width:100%;height:100%;object-fit:cover}
.mx-info{padding:0 14px}
.mx-rate{font-size:12.5px;margin:0 0 6px;display:flex;align-items:center;gap:7px}
.mx-rate.c{justify-content:center}
.mx-live{width:9px;height:9px;border-radius:50%;background:#2fb36b;box-shadow:0 0 0 3px rgba(47,179,107,.2)}
.mx h1{font-size:21px;font-weight:600;line-height:1.25}
.mx-ticks{list-style:none;margin:12px 0;padding:0;display:grid;gap:8px}
.mx-ticks li{position:relative;padding-left:26px;font-size:14.5px;color:#2b2b2b;letter-spacing:.2px}
.mx-ticks li:before{content:"✓";position:absolute;left:0;top:1px;width:17px;height:17px;border-radius:50%;background:var(--a);color:#fff;font-size:11px;display:grid;place-items:center;font-weight:700}
.mx-prog{display:flex;align-items:center;gap:12px;border-radius:10px;box-shadow:0 2px 14px rgba(0,0,0,.08);padding:14px;margin:14px 0}
.mx-track{flex:1;height:8px;border-radius:9px;background:#f1e3e8;overflow:hidden}.mx-track span{display:block;height:100%;background:var(--a);border-radius:9px}
.mx-prog b{font-size:13px;color:var(--a);font-weight:600;white-space:nowrap}
.mx-pricerow{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.mx-pricerow b{color:var(--a);font-size:19px;font-weight:600;font-family:Poppins}.mx-pricerow s{color:#555;font-size:14px}
.mx-pill{background:var(--a);color:#fff;font-size:11px;font-weight:600;padding:4px 9px;border-radius:4px}
.mx-divider{display:flex;align-items:center;gap:10px;color:var(--a);font-weight:600;font-size:14px;margin:18px 0 10px}
.mx-divider:before,.mx-divider:after{content:"";flex:1;height:1px;background:var(--a);opacity:.5}
.mx-packs{display:grid;gap:12px}
.mx-pk{position:relative;display:grid;grid-template-columns:64px 1fr auto;align-items:center;gap:12px;border:1.5px solid #e2d6d9;border-radius:6px;padding:14px 12px;cursor:pointer;background:#fff}
.mx-pk input{position:absolute;opacity:0;inset:0}
.mx-pk:has(input:checked){border:2px solid var(--a);background:var(--pe)}
.mx-pk img{width:64px;height:auto}
.mx-pk .t b{display:block;font-size:14px;color:var(--ink);font-weight:700}.mx-pk .t small{font-size:11.5px;color:#666}
.mx-pk .p{text-align:right}.mx-pk .p b{display:block;color:var(--a);font-size:16px;font-weight:600}.mx-pk .p s{font-size:12.5px;color:#444}
.mx-pk em{position:absolute;top:-11px;right:12px;background:var(--a);color:#fff;font-size:11px;font-weight:700;padding:3px 12px;border-radius:12px 12px 0 0}
.mx-pk em.b{background:var(--a2)}
.mx-oneoff{display:flex;gap:12px;align-items:center;border:1.5px dashed var(--a);border-radius:6px;padding:12px;margin:12px 0}
.mx-oneoff>span{width:22px;height:22px;border:2px solid var(--a);color:var(--a);display:grid;place-items:center;font-weight:700;font-size:13px}
.mx-oneoff b{display:block;color:var(--a);font-size:13.5px}.mx-oneoff small{font-size:12px;color:#444}
.mx-atc{display:block;width:100%;border:0;border-radius:7px;background:var(--a);color:#fff;padding:15px 18px;cursor:pointer;text-align:center;font-family:inherit;box-shadow:0 6px 16px rgba(168,51,106,.25)}
.mx-atc .a{display:block;font-size:15px;font-weight:700;letter-spacing:2px}.mx-atc i{font-style:normal;opacity:.6;margin:0 6px}.mx-atc s{opacity:.6;font-weight:500;font-size:12px;letter-spacing:0}
.mx-atc .s{display:block;font-size:11px;opacity:.85;margin-top:3px;letter-spacing:.4px}
.mx-subrow{display:flex;justify-content:center;gap:10px;font-size:12px;color:#444;margin:10px 0 16px}
.mx-gbox{display:flex;gap:14px;align-items:center;border:1px solid var(--ln);border-radius:8px;padding:14px;background:var(--pe2)}
.mx-badge{flex:0 0 54px;height:54px;border-radius:50%;background:var(--a2);color:#ffe08a;display:grid;place-items:center;text-align:center;font-family:Poppins;font-weight:600;font-size:12px;line-height:1;box-shadow:0 0 0 3px #fff,0 0 0 5px var(--a2)}
.mx-gbox b{font-size:14.5px;color:var(--ink)}.mx-gbox p{margin:3px 0 0;font-size:12.5px;line-height:1.4}.mx-gbox p span{color:var(--a);font-weight:700}
.mx-warn{border:1.5px dashed #d8a0b7;background:#fff7f9;border-radius:8px;padding:12px 14px;margin:14px 0}
.mx-warn b{color:var(--a2);font-size:13px}.mx-warn p{margin:4px 0 0;font-size:12px;line-height:1.45}
.mx-acc details{border:1px solid var(--ln);border-radius:6px;margin-bottom:10px;background:#fff}
.mx-acc summary{list-style:none;cursor:pointer;padding:16px;font-family:Poppins;font-weight:600;font-size:15px;color:var(--ink);position:relative}
.mx-acc summary:after{content:"+";position:absolute;right:16px;top:12px;font-size:22px;font-weight:400}
.mx-acc details[open] summary:after{content:"–"}
.mx-acc summary::-webkit-details-marker,.mx-faq summary::-webkit-details-marker,.mx-b summary::-webkit-details-marker{display:none}
.mx-acc p,.mx-acc ul{margin:0;padding:0 16px 14px;font-size:13.5px;line-height:1.55}.mx-cl{padding-left:32px!important}
.mx-say{text-align:center;font-family:Poppins;font-weight:600;color:var(--ink);margin:20px 0 10px}
.mx-vids{display:flex;gap:10px;overflow-x:auto;scrollbar-width:none;margin:0 -14px;padding:0 14px}
.mx-vids figure{flex:0 0 46%;margin:0;border-radius:8px;overflow:hidden;aspect-ratio:4/5;background:#f7d6e0}
.mx-vids img{width:100%;height:100%;object-fit:cover}
/* sections */
.mx-sec{padding:44px 0}.mx-sec.peach{background:var(--pe)}.mx-sec.peach2{background:#fff3ef}
.mx-acc-sec{background:var(--a);color:#fff;padding:44px 0;text-align:center}
.mx-acc-sec h2{color:#fff;font-weight:400;font-size:26px;line-height:1.2;letter-spacing:.5px}
.mx-h{text-align:center;font-weight:400;font-size:24px;line-height:1.25}
.mx-h.s{font-size:19px}
.mx-lead{text-align:center;font-size:15px;line-height:1.6;margin:12px auto 0;color:#333}.mx-lead.w{color:#fff;opacity:.92}
.mx-stats{text-align:left}.mx-stats h2{text-align:center;margin-bottom:10px}
.mx-st{border-bottom:1px solid rgba(255,255,255,.3);padding:18px 0}.mx-st b{display:block;font-family:Poppins;font-weight:400;font-size:36px;color:#fff}.mx-st p{margin:4px 0 0;font-size:15px;line-height:1.45;color:rgba(255,255,255,.92)}
.mx-wbtn{display:block;width:100%;margin:26px auto 0;background:#fff;color:var(--ink);border:0;border-radius:35px;padding:18px;font-family:Poppins;font-size:17px;cursor:pointer}
