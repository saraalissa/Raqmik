.mx-obtn{display:block;width:100%;max-width:310px;margin:26px auto 0;background:var(--a);color:#fff;border:0;border-radius:30px;padding:15px 26px;font-family:Poppins;font-size:16px;font-weight:500;cursor:pointer;letter-spacing:.6px}
.mx-gl{text-align:center;font-size:13.5px;margin:12px 0 0;letter-spacing:.5px;color:#333}.mx-gl.w{color:#fff}
.mx-src{font-size:11.5px;opacity:.8;text-align:center;margin:14px 0 0}
/* carousels */
.mx-car{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;margin:24px -16px 0;padding:0 16px 4px}
.mx-car::-webkit-scrollbar{display:none}
.mx-car article{flex:0 0 72%;scroll-snap-align:center;border:1px solid var(--ln);border-radius:10px;overflow:hidden;background:#fff;text-align:center}
.mx-car article img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block}
.mx-car h3{font-size:16px;font-weight:600;margin:16px 14px 8px}.mx-car p{margin:0 14px 18px;font-size:14px;line-height:1.55;color:#333}
.mx-car.r article{flex-basis:88%;text-align:left}.mx-car.r i{display:inline-block;margin:14px 14px 0;font-style:normal;background:var(--a);color:#fff;font-size:11px;font-weight:600;padding:4px 9px;border-radius:3px;text-transform:uppercase}
.mx-nav{display:flex;flex-direction:column;align-items:center;gap:12px;margin-top:16px}
.mx-dots{display:flex;gap:6px}.mx-dots i{width:7px;height:7px;border-radius:9px;background:#d9d9d9}.mx-dots i.on{width:22px;background:var(--a)}
.mx-nav button{width:34px;height:34px;border-radius:50%;border:0;background:#efefef;margin:0 6px;font-size:18px;cursor:pointer}
.mx-kp{display:table;margin:0 auto 12px;background:var(--a);color:#fff;font-size:12px;font-weight:600;padding:6px 12px;border-radius:3px;text-transform:uppercase;letter-spacing:.6px}
.mx-kp.t{background:none;color:var(--a);font-size:14px;letter-spacing:1.5px;padding:0;margin-top:14px}
/* stories */
.mx-stars{text-align:center;color:var(--a);font-size:22px;letter-spacing:6px;margin:0 0 6px}
.mx-stars.o{font-size:16px;letter-spacing:3px;margin:0}
.mx-thumbrow{display:flex;gap:8px;justify-content:center;margin:16px 0}
.mx-thumbrow img{width:22%;aspect-ratio:1/1;object-fit:cover;border-radius:8px}
.mx-rcard{border:1px solid var(--ln);border-radius:10px;background:#fff;padding:20px;margin-top:18px;box-shadow:0 2px 10px rgba(0,0,0,.04)}
.mx-rh{font-weight:700;color:var(--ink);margin:0 0 8px}.mx-rt{font-family:Poppins;font-size:18px;color:var(--ink);margin:0 0 8px}
.mx-rcard p{font-size:14.5px;line-height:1.6;margin:0 0 10px}.mx-rn{font-size:12.5px!important;color:#666}
.mx-tags{display:flex;gap:8px;flex-wrap:wrap}.mx-tags span{border:1px solid var(--a);color:var(--a);border-radius:20px;padding:5px 14px;font-size:12px}
/* feel */
.mx-icons{display:grid;grid-template-columns:1fr 1fr;gap:30px 10px;margin:30px 0 20px}
.mx-icons>div{text-align:center}.mx-icons svg{display:block;margin:0 auto;width:48px;height:48px;color:#fff}.mx-icons b{display:block;font-weight:400;font-size:16px;margin-top:10px}
.mx-feel{background:#a4345e;padding-bottom:0}
.mx-jar{display:block;width:calc(100% + 32px);max-width:none;margin:10px -16px 0;height:auto;-webkit-mask-image:linear-gradient(180deg,transparent 0,#000 14%);mask-image:linear-gradient(180deg,transparent 0,#000 14%)}
/* benefits */
.mx-blist{display:grid;gap:14px;margin-top:24px}
.mx-b{border:1px solid var(--ln);border-radius:8px;background:#fff}
.mx-b summary{list-style:none;display:grid;grid-template-columns:84px 1fr 24px;gap:14px;align-items:center;padding:12px;cursor:pointer}
.mx-b img{width:84px;height:84px;border-radius:6px;object-fit:cover}
.mx-b b{display:block;font-family:Poppins;font-weight:500;color:var(--ink);font-size:15.5px}.mx-b small{font-size:13px;color:#555}
