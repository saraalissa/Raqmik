.mm .mm-cks li{position:relative;padding-left:28px;font-weight:600;font-size:15px;line-height:1.35}
.mm .mm-cks li:before{content:"";position:absolute;left:0;top:1px;width:19px;height:19px;border-radius:50%;background:var(--mm-berry)}
