.mm .mm-rail::-webkit-scrollbar{display:none}
.mm .mm-rail>*{scroll-snap-align:start}
.mm .mm-club .mm-rail figure{flex:0 0 72%;max-width:320px;margin:0;border-radius:20px;overflow:hidden;background:var(--mm-pink)}
.mm .mm-club .mm-rail img{width:100%;height:auto;display:block}
.mm .mm-club{background:var(--mm-plum)}
.mm .mm-club h2{color:#fff}.mm .mm-club .mm-lead{color:#f3cfdc}
