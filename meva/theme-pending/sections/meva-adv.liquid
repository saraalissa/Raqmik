{%- comment -%}
  Mëva advertorial (listicle, "7 reasons"). Layout mirrors a high-converting US advertorial; content is Mëva's own.
  Honest rules: clearly labelled as Mëva content, no invented reviews, ratings, customer counts or stock levels,
  UK-authorised magnesium claims only. CTAs go to the product page and keep the ad's UTM tags.
{%- endcomment -%}
{%- liquid
  assign pr = all_products['meva-magnesium-gummies']
  assign v1 = pr.variants.first
  assign v3 = pr.variants.first
  for v in pr.variants
    if v.title contains '3'
      assign v3 = v
    elsif v.title contains '1'
      assign v1 = v
    endif
  endfor
  assign was3 = v1.price | times: 3
  assign cta = '/products/meva-magnesium-gummies?reserve=3'
-%}
