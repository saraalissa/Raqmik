<style>
.av{--a:#a8336a;font-family:'Open Sans',sans-serif;color:#121212;background:#fff;padding-bottom:70px}
.av *{box-sizing:border-box}
.av-top{background:#2a2a2a;color:#fff;text-align:center;font-weight:700;font-size:14px;padding:9px}
.av-top span{font-weight:400;opacity:.75;font-size:12px}
.av-w{max-width:680px;margin:0 auto;padding:0 12px}
.av h1{font-family:'Open Sans';font-weight:800;font-size:29px;line-height:1.3;letter-spacing:.3px;margin:22px 0 16px;color:#121212}
.av h2{font-family:'Open Sans';font-weight:700;font-size:24px;line-height:1.33;margin:40px 0 16px;color:#121212;letter-spacing:.2px}
.av p{font-size:17px;line-height:1.42;margin:0 0 18px;letter-spacing:.3px}
.av-by{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.av-by p{font-size:14px;margin:0;line-height:1.3}
.av-av{width:50px;height:50px;border-radius:50%;background:var(--a);color:#fff;display:grid;place-items:center;font-weight:800;font-size:24px}
.av-q{margin:0 0 20px;background:#f4f4f4;border-left:4px solid var(--a);padding:12px 18px;font-size:16px;line-height:1.35}
.av-tbl{border-radius:6px;font-size:13px;margin-bottom:18px}
.av-tbl>div{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;align-items:center;text-align:center}
.av-tbl>div>*{padding:14px 4px}
.av-tbl span{text-align:left;font-weight:700;font-size:13px}
.av-tbl i{font-style:normal;color:#333}
.av-tbl .us{background:#fbeef3;border-left:3px solid var(--a);border-right:3px solid var(--a);color:#121212}
.av-tbl .h b{font-size:13.5px;font-weight:700;align-self:end}
.av-tbl .h b.us{border-top:3px solid var(--a);border-radius:10px 10px 0 0;font-style:italic;color:var(--a)}
.av-tbl .h img{display:block;width:40px;height:auto;margin:-30px auto 4px}
.av-tbl>div:last-child .us{border-bottom:3px solid var(--a);border-radius:0 0 10px 10px}
.av-tldr b{font-size:16px}
.av-img{display:block;width:100%;height:auto;border-radius:10px;margin:0 0 20px}
.av-src{font-style:italic;font-size:16px!important;color:#333}
.av-grid{display:grid;grid-template-columns:1fr 1fr;gap:3px;border-radius:10px;overflow:hidden;margin-bottom:6px}
.av-grid img{width:100%;aspect-ratio:1/1;object-fit:cover;display:block}
.av-cap{font-size:12.5px!important;color:#666;margin-bottom:18px!important}
.av-rev{border:1px solid #e6e6e6;border-radius:8px;padding:18px;box-shadow:0 2px 10px rgba(0,0,0,.06);margin:0 0 18px}
.av-rev>b{font-size:15px}.av-rev .big{font-size:24px;font-weight:800;margin:8px 0}.av-rev small{display:block;color:#666;font-size:12.5px;line-height:1.4}
.av-offer{position:relative;border:1.5px dashed #999;margin:46px 0 20px;text-align:center;padding:0 0 14px}
.av-tab{position:absolute;top:-22px;left:50%;transform:translateX(-50%);background:var(--a);color:#fff;font-weight:700;font-size:14px;padding:10px 26px;white-space:nowrap}
.av-offer img{width:100%;display:block}
.av-big{font-size:30px!important;font-weight:800;line-height:1.25!important;margin:12px 10px 4px!important;letter-spacing:.5px}
.av-big span{color:#c4151c}
.av-sm{font-size:15px!important;margin:0 14px 18px!important}
.av-cta{display:inline-block;background:var(--a);color:#fff;font-weight:700;font-size:20px;padding:20px 48px;border-radius:40px;text-decoration:none;box-shadow:0 8px 18px rgba(0,0,0,.18)}
.av-end{font-weight:800;font-size:14px!important;letter-spacing:1px;margin:10px 0 14px!important}
.av-row{display:flex;justify-content:center;align-items:center;gap:20px;background:#fdf1f5;margin:0 12px;padding:10px;font-size:14px}
.av-row i{width:1px;height:20px;background:#333}
.av-g{font-size:14.5px!important;margin:12px 0 0!important}
.av-foot{background:var(--a);color:#fff;text-align:center;font-size:12.5px;line-height:1.5;padding:12px 16px;max-width:680px;margin:0 auto}
.av-sticky{position:fixed;left:0;right:0;bottom:0;z-index:60;display:flex;justify-content:space-between;align-items:center;gap:10px;background:#fff;padding:10px 14px calc(10px + env(safe-area-inset-bottom));box-shadow:0 -4px 14px rgba(0,0,0,.1);text-decoration:none;color:#121212}
.av-sticky span{font-weight:700;font-size:14px}
.av-sticky b{background:var(--a);color:#fff;padding:12px 18px;border-radius:30px;font-size:15px}
</style>
<script>
(function(){var UP=['utm_source','utm_medium','utm_campaign','utm_term','utm_content','placement'],q=new URLSearchParams(location.search);
window.MV_LP='advertorial';
document.querySelectorAll('.av a[href^="/products/"]').forEach(function(a){try{var u=new URL(a.getAttribute('href'),location.origin);UP.forEach(function(k){var v=q.get(k);if(v&&!u.searchParams.get(k))u.searchParams.set(k,v);});if(!u.searchParams.get('utm_content')&&q.get('utm_content'))u.searchParams.set('utm_content',q.get('utm_content'));u.searchParams.set('from','adv');a.href=u.pathname+u.search+'#club';}catch(e){}});})();
</script>
