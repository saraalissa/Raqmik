@media (min-width:861px){.mv5 .hero h1{font-size:clamp(48px,5vw,72px)}}
#header-group,#header-group>.shopify-section,.mv5.mv5-head{background:transparent!important}
.mv5 .qb{padding-block:clamp(16px,3vw,40px) clamp(32px,5vw,64px)}
.mv5 .qbox{display:grid;grid-template-columns:1fr 1fr;gap:clamp(20px,4vw,48px);background:#fff;border-radius:32px;padding:clamp(16px,2.5vw,28px);box-shadow:0 18px 50px rgba(61,15,39,.08);align-items:center}
.mv5 .qimg{position:relative;border-radius:24px;overflow:hidden;background:var(--cream);aspect-ratio:1/1}
.mv5 .qimg img{width:100%;height:100%;object-fit:cover;display:block}
.mv5 .qsale{position:absolute;top:14px;left:14px;background:var(--berry);color:#fff;font-weight:800;font-size:14px;border-radius:999px;padding:7px 14px}
.mv5 .qtxt h2{font-size:clamp(30px,4vw,42px);margin-top:4px}
.mv5 .qsub{color:var(--muted);margin-top:6px}
.mv5 .qrows{display:flex;flex-direction:column;gap:10px;margin-top:18px}
.mv5 .qr{display:grid;grid-template-columns:22px 1fr auto;gap:12px;align-items:center;border:2px solid var(--line);border-radius:18px;padding:14px 16px;cursor:pointer;background:#fff;transition:border-color .15s,background .15s}
.mv5 .qr input{position:absolute;opacity:0;pointer-events:none}
.mv5 .qr .rd{width:22px;height:22px;border-radius:50%;border:2px solid var(--line);display:block}
.mv5 .qr:has(input:checked){border-color:var(--plum);background:var(--lilac)}
.mv5 .qr:has(input:checked) .rd{border:7px solid var(--plum)}
.mv5 .qr:has(input:focus-visible){outline:3px solid var(--berry);outline-offset:2px}
.mv5 .qt{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px}
.mv5 .qt b{font-size:17px;color:var(--plum)}
.mv5 .qt small{flex-basis:100%;color:var(--muted);font-size:13.5px}
.mv5 .qtag{background:var(--berry);color:#fff;font-size:11.5px;font-weight:800;border-radius:999px;padding:3px 9px;text-transform:uppercase;letter-spacing:.03em}
.mv5 .qtag.y{background:var(--butter);color:var(--plum)}
.mv5 .qp{display:flex;flex-direction:column;align-items:flex-end;text-align:right}
.mv5 .qp b{font-family:var(--display);font-weight:800;font-size:19px;color:var(--plum)}
.mv5 .qp s{color:var(--muted);font-size:13px}
.mv5 .qp small{color:var(--berry);font-weight:700;font-size:13px}
.mv5 .qcta{width:100%;min-height:60px;font-size:18px;margin-top:16px}
.mv5 .qnote{text-align:center;color:var(--muted);font-size:13.5px;margin-top:10px}
.mv5 .qtrust{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:18px;border-top:1.5px solid var(--line);padding-top:16px}
.mv5 .qtrust div{display:flex;flex-direction:column;align-items:center;text-align:center;gap:6px;font-size:13px;font-weight:600;color:var(--plum);line-height:1.3}
.mv5 .qtrust img{width:52px;height:52px;object-fit:contain}
@media (max-width:860px){.mv5 .qbox{grid-template-columns:1fr;border-radius:26px}.mv5 .qimg{aspect-ratio:4/3}}
.mv5 .band{background:var(--paper);color:var(--muted);padding-block:clamp(20px,3vw,40px)}
.mv5 .band .wrap{gap:14px}
.mv5 .band .wrap>div{background:#fff;border-radius:24px;padding:18px 18px 20px;box-shadow:0 10px 30px rgba(61,15,39,.06)}
.mv5 .band i.bi.bc{width:84px;height:84px;margin:-6px 0 0 -8px;background:none}
.mv5 .band i.bi.bc img{-webkit-mask-image:none;mask-image:none;object-fit:contain}
.mv5 .band h3{color:var(--plum);margin-top:8px;font-size:18px;line-height:1.2}
.mv5 .band p{color:var(--muted);font-size:14.5px;line-height:1.45;margin-top:6px}
@media (max-width:860px){.mv5 .band .wrap{gap:10px}.mv5 .band .wrap>div{padding:14px 14px 16px;border-radius:20px}.mv5 .band i.bi.bc{width:68px;height:68px}.mv5 .band h3{font-size:16.5px}.mv5 .band p{font-size:13.5px}}

.mv5 table.cmp.cmp2 th[scope=row]{width:26%}
.mv5 table.cmp.cmp2 .us{width:37%}

.mv5 .rit{background:var(--lilac)}
.mv5 .ritbox{background:#fff;border-radius:32px;overflow:hidden;display:grid;grid-template-columns:1fr 1fr}
.mv5 .ritbox .txt{padding:clamp(28px,4vw,52px);display:flex;flex-direction:column;gap:18px;justify-content:center}
.mv5 .ritbox .photo{border-radius:0;min-height:320px}
.mv5 .rsteps{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px;counter-reset:r}
.mv5 .rsteps li{counter-increment:r;display:grid;grid-template-columns:44px 1fr;column-gap:12px}
.mv5 .rsteps li::before{content:"0" counter(r);grid-row:span 2;font-family:var(--display);font-weight:800;font-size:22px;color:var(--berry)}
.mv5 .rsteps b{font-size:17px;color:var(--plum)}
.mv5 .rsteps span{font-size:15px;color:var(--muted)}
.mv5 .ritbox .btn{align-self:flex-start}
.mv5 .fgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:40px}
.mv5 .fc{background:#fff;border-radius:22px;padding:20px;display:flex;flex-direction:column;gap:8px}
.mv5 .fc i,.mv5 .ic2 i,.mv5 .qc i{width:44px;height:44px;border-radius:50%;background:var(--lilac);color:var(--berry);display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.mv5 .fc h3{font-size:16px}
.mv5 .fc p{font-size:14px;color:var(--muted)}
.mv5 .inside .head{display:flex;justify-content:space-between;align-items:flex-end;gap:20px;flex-wrap:wrap;margin-bottom:32px}
.mv5 .inside .head>p{max-width:44ch;color:var(--muted)}
.mv5 .ingrid{display:grid;grid-template-columns:.8fr 1.2fr;gap:18px;align-items:stretch}
.mv5 .ingrid .photo{min-height:340px}
.mv5 .icards{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.mv5 .ic2{background:var(--lilac);border-radius:22px;padding:18px;display:flex;gap:12px;align-items:flex-start}
.mv5 .ic2 i{background:#fff}
.mv5 .ic2 h3{font-size:16px}
.mv5 .ic2 p{font-size:14px;color:var(--muted);margin-top:2px}
.mv5 .qband{background:#420723;color:#f3dbe7}
.mv5 .faq{background:var(--lilac)}
.mv5 .close{padding-top:clamp(40px,6vw,72px)}
.mv5 .qband h2{color:#fff}
.mv5 .qband .sub2{margin-top:8px}
.mv5 .qgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:28px}
.mv5 .qc{border:1px solid #6b2a4c;border-radius:22px;padding:22px;display:flex;flex-direction:column;gap:8px}
.mv5 .qc i{background:#5a1a3a;color:var(--butter)}
.mv5 .qc h3{color:#fff;font-size:17px}
.mv5 .qc p{font-size:14px;color:#e9cfdb}
.mv5 .close .cimg{background:var(--lilac);display:flex;flex-direction:column;gap:16px;padding:clamp(20px,3vw,32px);justify-content:center}
.mv5 .close .cimg .photo{aspect-ratio:4/3;border-radius:22px;min-height:0}
.mv5 .cfeat{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:10px;font-weight:600;font-size:14px}
.mv5 .close .fine2{font-size:13px}
@media (max-width:860px){.mv5 .ritbox,.mv5 .ingrid{grid-template-columns:1fr}.mv5 .fgrid,.mv5 .qgrid{grid-template-columns:1fr 1fr}.mv5 .icards{grid-template-columns:1fr}.mv5 .ritbox .photo{order:-1;min-height:260px}}
@media (max-width:520px){.mv5 .fgrid,.mv5 .qgrid,.mv5 .cfeat{grid-template-columns:1fr}}
</style>
{%- liquid
  assign shop_url = routes.root_url
  if section.settings.product_handle != blank
    assign shop_url = '/products/' | append: section.settings.product_handle
  endif
  assign home = routes.root_url
  if home == '/'
    assign home = ''
  endif
-%}
<style>#header-group{position:sticky;top:calc(-1 * var(--mv-annh,38px));z-index:40}</style>
<script>(function(){function m(){var a=document.querySelector('.mv5-head .ann');if(a)document.documentElement.style.setProperty('--mv-annh',a.offsetHeight+'px');}m();window.addEventListener('load',m);window.addEventListener('resize',m);})();</script>
<div class="mv5 mv5-head">
  <div class="ann" role="region" aria-label="Offers">{%- assign ann_items = section.settings.announcement | split: '|' -%}<div class="mq">{%- for g in (1..2) -%}<div class="grp"{% if g == 2 %} aria-hidden="true"{% endif %}>{%- for it in ann_items -%}<span class="it">{{ it | strip }}</span>{%- endfor -%}{%- for it in ann_items -%}<span class="it">{{ it | strip }}</span>{%- endfor -%}</div>{%- endfor -%}</div></div>
  <header class="hdr"><div class="wrap">
    <a class="logo" href="{{ routes.root_url }}">{{ section.settings.brand_name | downcase }}</a>
    <nav class="hnav" aria-label="Main">
      <a href="{{ shop_url }}">Shop</a>
      <a href="{{ routes.root_url }}pages/ingredients">What&#39;s inside</a>
      <a href="{{ routes.root_url }}pages/why-meva">Why {{ section.settings.brand_name }}</a>
      <a href="{{ routes.root_url }}pages/our-story">Our story</a>
      <a href="{{ home }}/#faq">FAQ</a>
    </nav>
    <div class="hr">
      {%- if section.settings.waitlist_mode -%}<a class="btn" href="{{ shop_url }}#club">Join the club</a>{%- else -%}<a class="btn" href="{{ shop_url }}">Shop now</a>{%- endif -%}
      <details class="mnav"><summary class="ico" aria-label="Menu"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></summary>
        <nav class="mpanel" aria-label="Mobile">
          <a href="{{ shop_url }}">Shop</a>
          <a href="{{ routes.root_url }}pages/ingredients">What&#39;s inside</a>
          <a href="{{ routes.root_url }}pages/why-meva">Why {{ section.settings.brand_name }}</a>
          <a href="{{ routes.root_url }}pages/our-story">Our story</a>
          <a href="{{ home }}/#faq">FAQ</a>
          <a href="{{ routes.root_url }}pages/contact">Contact</a>
          {%- if section.settings.waitlist_mode -%}<a class="btn" href="{{ shop_url }}#club">Join the club</a>{%- else -%}<a class="btn" href="{{ shop_url }}">Shop now</a>{%- endif -%}
        </nav>
      </details>
      {%- unless section.settings.waitlist_mode -%}<a class="ico" href="{{ routes.cart_url }}" aria-label="Basket, {{ cart.item_count }} items"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" aria-hidden="true"><path d="M5 8h14l-1.2 12H6.2z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>{%- if cart.item_count > 0 -%}<span class="count">{{ cart.item_count }}</span>{%- endif -%}</a>{%- endunless -%}
    </div>
  </div></header>
{%- unless request.design_mode or request.page_type == '404' -%}{% render 'meva-club-pop' %}{%- endunless -%}
{% render 'meva-clarity' %}
</div>

{% schema %}
{
  "name": "Mëva header",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Mëva" },
    { "type": "checkbox", "id": "waitlist_mode", "label": "Waitlist mode (hide basket, header button joins the club)", "default": true },
    { "type": "text", "id": "announcement", "label": "Announcement", "default": "Free UK delivery on 2+ jars | Up to 33% off multipacks | 30-day first-jar guarantee | Vegan & gelatine-free | Packed in the UK | One-off orders, no subscription", "info": "Separate messages with |" },
    { "type": "text", "id": "announcement_mobile", "label": "Announcement (mobile, short)", "default": "Free UK delivery on 2+ jars · 30-day first-jar guarantee" },
    { "type": "text", "id": "product_handle", "label": "Product handle", "default": "meva-magnesium-gummies" }
  ]
}
{% endschema %}
