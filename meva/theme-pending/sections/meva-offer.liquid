{%- comment -%} Mëva ad landing page (/pages/offer). Shared styles come from sections/meva-header.liquid. {%- endcomment -%}
{%- liquid
  assign is_product = false
  assign p = all_products[section.settings.product_handle]
  assign v1 = p.variants.first
  assign v2 = p.variants.first
  assign v3 = p.variants.first
  for v in p.variants
    if v.title contains '3'
      assign v3 = v
    elsif v.title contains '2'
      assign v2 = v
    else
      assign v1 = v
    endif
  endfor
  assign each3 = v3.price | divided_by: 3
  assign each2 = v2.price | divided_by: 2
  assign save3 = v3.price | times: 100.0 | divided_by: v1.price | divided_by: 3 | round | minus: 100 | abs
  assign save2 = v2.price | times: 100.0 | divided_by: v1.price | divided_by: 2 | round | minus: 100 | abs
  assign n = section.settings.jar_count
  assign pd1 = v1.price | times: 1.0 | divided_by: n | round
  assign pd2 = v2.price | times: 1.0 | divided_by: n | divided_by: 2 | round
  assign pd3 = v3.price | times: 1.0 | divided_by: n | divided_by: 3 | round
  assign sv2 = v1.price | times: 2 | minus: v2.price
  assign sv3 = v1.price | times: 3 | minus: v3.price
  assign brand = section.settings.brand_name
  assign home = routes.root_url
  if home == '/'
    assign home = ''
  endif
  assign img_jar = section.settings.jar_image
  if img_jar == blank
    assign img_jar = p.featured_image
  endif
-%}
<style>
/* Ad landing page: hide site navigation so the only action is buying */
#header-group .hnav,#header-group .mnav,#header-group .hr .btn,#header-group .hr .ico{display:none!important}
#header-group .logo{pointer-events:none}
.mv5 .ftr .cols>div:nth-child(2),.mv5 .ftr .cols>div:nth-child(3){display:none}
.mv5 .oh1{font-size:clamp(34px,5vw,54px);line-height:1;margin-top:8px}
.mv5 .oh1 em{font-style:normal;color:var(--berry)}
.mv5 .ocks{margin-top:14px;display:flex;flex-direction:column;gap:8px;font-weight:600;font-size:15px}
.mv5 .ochoose{margin-top:20px;font-weight:800;color:var(--plum);font-size:17px}
.mv5 .ochoose+.qrows{margin-top:10px}
.mv5 .qb.ofirst{padding-top:clamp(12px,2vw,28px)}
@media (max-width:860px){.mv5 .qb.ofirst .qimg{aspect-ratio:16/11}}
</style>
<div class="mv5">
  <section class="qb ofirst" id="buy"><div class="wrap"><div class="qbox">
    <div class="qimg">{%- if img_jar != blank -%}{{ img_jar | image_url: width: 900 | image_tag: alt: img_jar.alt, loading: 'eager', fetchpriority: 'high', sizes: '(max-width: 860px) 100vw, 45vw', widths: '450, 900' }}{%- endif -%}<span class="qsale">Up to {{ save3 }}% off</span></div>
