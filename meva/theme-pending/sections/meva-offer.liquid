      <p class="ochoose">Choose your pack</p>
      <div class="packs2 qpacks">
        <label class="pk2"><input type="radio" name="qbv" data-href="{% if section.settings.waitlist_mode %}?reserve=1#club{% else %}{{ routes.root_url }}cart/{{ v1.id }}:1{% endif %}" value="{{ v1.id }}" data-price="{{ v1.price | money }}" data-note="1 jar · + {{ section.settings.single_delivery }} delivery"><span class="t"><b>1 jar</b><span class="sup">{{ n }}-day supply</span></span><span class="p"><b>{{ v1.price | money }}</b><small>~{{ pd1 | money }} a day</small></span><span class="extra"><span class="ln"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>UK delivery {{ section.settings.single_delivery }}</span><span class="ln"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ section.settings.guarantee_days }}-day guarantee</span></span></label>
        <label class="pk2"><input type="radio" name="qbv" data-href="{% if section.settings.waitlist_mode %}?reserve=2#club{% else %}{{ routes.root_url }}cart/{{ v2.id }}:1{% endif %}" value="{{ v2.id }}" data-price="{{ v2.price | money }}" data-note="2 jars · free delivery" checked><span class="t"><b>2 jars</b><span class="tag">Our pick</span><span class="sup">{{ n | times: 2 }}-day supply</span></span><span class="p"><b>{{ v2.price | money }}</b><small>~{{ pd2 | money }} a day</small></span><span class="extra"><span class="savepill">Save {{ sv2 | money }} vs 2 single jars</span><span class="ln fs"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>FREE UK delivery included</span><span class="ln"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ section.settings.guarantee_days }}-day guarantee</span></span></label>
        <label class="pk2"><input type="radio" name="qbv" data-href="{% if section.settings.waitlist_mode %}?reserve=3#club{% else %}{{ routes.root_url }}cart/{{ v3.id }}:1{% endif %}" value="{{ v3.id }}" data-price="{{ v3.price | money }}" data-note="3 jars · free delivery"><span class="t"><b>3 jars</b><span class="tag">Best price</span><span class="sup">{{ n | times: 3 }}-day supply</span></span><span class="p"><b>{{ v3.price | money }}</b><small>~{{ pd3 | money }} a day</small></span><span class="extra"><span class="savepill">Save {{ sv3 | money }} vs 3 single jars</span><span class="ln fs"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>FREE UK delivery included</span><span class="ln"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ section.settings.guarantee_days }}-day guarantee</span></span></label>
      </div>
      {%- if section.settings.waitlist_mode -%}<a class="btn qcta" id="mv-qcta" href="?reserve=2#club">Reserve mine</a>
      <p class="qnote">Launching soon. Nothing to pay today. Founding 500: 20% off your first order, free UK delivery on 2+ jars and our no-drama guarantee on your first jar.</p>{%- else -%}<a class="btn qcta" id="mv-qcta" href="{{ routes.root_url }}cart/{{ v2.id }}:1">Get {{ brand }}</a>
      <p class="qnote">One-off purchase. No subscription. Prices include VAT.</p>{%- endif -%}
      <div class="qtrust">
        <div><img src="{{ 'meva-clayp2.png' | file_url }}" alt="" width="56" height="56" loading="lazy"><span>{{ section.settings.guarantee_days }}-day first-jar guarantee</span></div>
        <div><img src="{{ 'meva-clayp3.png' | file_url }}" alt="" width="56" height="56" loading="lazy"><span>Free tracked UK delivery on 2+ jars</span></div>
        <div><img src="{{ 'meva-clayp1.png' | file_url }}" alt="" width="56" height="56" loading="lazy"><span>Vegan, gelatine-free berry gummy</span></div>
      </div>
    </div>
  </div></div></section>
  <script>(function(){var c=document.getElementById('mv-qcta');if(!c)return;document.querySelectorAll('.mv5 .qpacks input').forEach(function(r){r.addEventListener('change',function(){c.href=r.getAttribute('data-href');});});})();</script>

  {%- if section.settings.waitlist_mode -%}
  <section class="clubsec" style="padding:clamp(40px,6vw,72px) 0;background:#f6e6dc"><div class="wrap" style="display:flex;justify-content:center">{% render 'meva-club-form', fid: 'club' %}</div></section>
  <script>(function(){var r=new URLSearchParams(location.search).get('reserve');if(!r)return;var i=document.querySelector('.mv5 .qpacks input[data-href*="reserve='+r.replace(/[^0-9]/g,'')+'"]');if(i){i.checked=true;var c=document.getElementById('mv-qcta');if(c)c.href=i.getAttribute('data-href');}})();</script>
  {%- endif -%}
  <section class="rit" id="how"><div class="wrap"><div class="ritbox">
    <div class="txt"><p class="kick">The ritual</p><h2>Three steps. Under a minute.</h2>
      <ol class="rsteps"><li><b>Keep the jar by the kettle</b><span>Where you&#39;ll see it every morning.</span></li><li><b>Chew two berry gummies</b><span>Straight from the jar, with your morning tea.</span></li><li><b>Get on with your day</b><span>That&#39;s your magnesium done. Give it the full {{ n }} days. You&#39;d do the same for a new mascara.</span></li></ol>
      <a class="btn" href="#buy">Choose your pack</a></div>
    <div class="photo">{%- if section.settings.moment1_image != blank -%}{{ section.settings.moment1_image | image_url: width: 1100 | image_tag: alt: section.settings.moment1_image.alt, loading: 'lazy' }}{%- endif -%}</div>
  </div></div></section>
<section class="otl"><div class="wrap">
    <p class="kick">What to expect</p>
    <h2>Your first jar, day by day.</h2>
    <ol>
      <li><span>Day 1</span><b>Two by the kettle.</b><p>Open the jar, two gummies, four seconds. No water.</p></li>
      <li><span>Day 7</span><b>It&#39;s a habit now.</b><p>Same time every day. The jar lives in your bag on busy days.</p></li>
      <li><span>Day 14</span><b>Halfway.</b><p>28 gummies in. Keep showing up for you.</p></li>
      <li><span>Day 30</span><b>Jar finished. Honest check-in.</b><p>Loving it? Keep going. Not for you? We&#39;ll refund your first jar.</p></li>
