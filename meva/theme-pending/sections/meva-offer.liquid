.mv5 .ogap .octa{margin-top:22px}
.mv5 .ogap .src{font-size:12px;line-height:1.5;color:var(--muted);margin:22px auto 0;max-width:560px}
</style>
{% schema %}
{
  "name": "Mëva offer page",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Mëva" },
    { "type": "checkbox", "id": "waitlist_mode", "label": "Waitlist mode (No Drama Club, no checkout)", "default": true },
    { "type": "text", "id": "product_handle", "label": "Product handle", "default": "meva-magnesium-gummies" },
    { "type": "number", "id": "jar_count", "label": "Days per jar (60 gummies at 2 a day)", "default": 30 },
    { "type": "text", "id": "guarantee_days", "label": "Guarantee days", "default": "30" },
    { "type": "text", "id": "single_delivery", "label": "Delivery price for 1 jar", "default": "£4.99" },
    { "type": "text", "id": "dose_text", "label": "Dose text", "default": "Adults: chew two gummies a day. Do not exceed the stated dose. Not recommended during pregnancy or breastfeeding unless advised by a healthcare professional." },
    { "type": "textarea", "id": "ingredients", "label": "Ingredients", "default": "Glucose syrup, sugar, magnesium citrate, water, pectin (gelling agent), citric acid (acid), trisodium citrate (acidity regulator), spirulina, anthocyanins (colour), coconut oil, natural flavouring, carnauba wax (glazing agent). Made without the 14 major allergens." },
    { "type": "text", "id": "contact_email", "label": "Contact email", "default": "info@trymeva.co" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "jar_image", "label": "Jar image" },
    { "type": "image_picker", "id": "macro_image", "label": "Gummies close-up" },
    { "type": "image_picker", "id": "moment1_image", "label": "Moment 1 (breakfast)" },
    { "type": "image_picker", "id": "moment2_image", "label": "Moment 2 (treat)" },
    { "type": "image_picker", "id": "moment3_image", "label": "Moment 3 (friends)" },
    { "type": "image_picker", "id": "closing_image", "label": "Closing image" }
  ],
  "presets": [{ "name": "Mëva offer page" }]
}
{% endschema %}
