{% schema %}
{
  "name": "Mëva ad landing page",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "Mëva" },
    { "type": "text", "id": "product_handle", "label": "Product handle", "default": "meva-magnesium-gummies" },
    { "type": "number", "id": "jar_count", "label": "Days per jar (60 gummies at 2 a day)", "default": 30 },
    { "type": "text", "id": "guarantee_days", "label": "Guarantee days", "default": "30" },
    { "type": "text", "id": "single_delivery", "label": "Delivery price for 1 jar", "default": "£4.99" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "image_picker", "id": "kitchen_image", "label": "Reason 1 image" },
    { "type": "image_picker", "id": "macro_image", "label": "Reason 2 image" },
    { "type": "image_picker", "id": "take_image", "label": "Reason 3 image" },
    { "type": "image_picker", "id": "jar_image", "label": "Reason 4 image" },
    { "type": "image_picker", "id": "friends_image", "label": "Reason 3 image" },
    { "type": "image_picker", "id": "hand_image", "label": "Reason 6 image" }
  ],
  "presets": [{ "name": "Mëva ad landing page" }]
}
{% endschema %}
