      <a class="pk2" href="/cart/{{ v3.id }}:1"><span class="go" aria-hidden="true"></span><span class="t"><b>3 jars</b><span class="tag">Best price</span><span class="sup">{{ n | times: 3 }}-day supply</span></span><span class="p"><b>{{ v3.price | money }}</b><small>~{{ pd3 | money }} a day</small></span><span class="extra"><span class="savepill">Save {{ sv3 | money }} vs 3 single jars</span><span class="ln fs"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>FREE UK delivery included</span><span class="ln"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>{{ g }}-day guarantee</span></span></a>
    </div>
    <a class="btn cta" href="/cart/{{ v2.id }}:1">Try now · 2 jars for {{ v2.price | money }} →</a>
    <a class="btn o cta2" href="{{ p.url }}">Learn more →</a>
    <div class="perks"><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.6"/><circle cx="17" cy="17.5" r="1.6"/></svg>Free UK delivery on 2+ jars ({{ section.settings.single_delivery }} for one jar)</span><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/></svg>Backed by our {{ g }}-day guarantee</span><span><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12a8 8 0 0114-5.3L20 9"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 01-14 5.3L4 15"/><path d="M4 20v-5h5"/></svg>One-off purchase. No subscription, nothing renews.</span></div>
  </div></section>
  <div class="lp-sbar"><div><b>2 jars · {{ v2.price | money }}</b><small>Free UK delivery · {{ g }}-day guarantee</small></div><a class="btn" href="/cart/{{ v2.id }}:1">Try now</a></div>
