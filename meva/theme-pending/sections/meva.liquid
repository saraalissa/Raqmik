<style>
/* Mëva home · clean + lively (original palette) */
@media (prefers-reduced-motion:no-preference){
.mv5 .mvr{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.2,.7,.2,1),transform .7s cubic-bezier(.2,.7,.2,1);transition-delay:var(--d,0s)}
.mv5 .mvr.in{opacity:1;transform:none}
.mv5 .hero h1.mvh,.mv5 .hero h1.mvh em{display:inline-block;opacity:0;transform:translateY(.35em);animation:mvup .9s cubic-bezier(.2,.7,.2,1) forwards}
.mv5 .hero h1.mvh{display:block}
.mv5 .hero h1.mvh em{display:inline;animation-delay:.35s}
@keyframes mvup{to{opacity:1;transform:none}}
@keyframes mvbreath{from{transform:scale(1)}to{transform:scale(1.035)}}
}
/* hover life */
.mv5 .fc,.mv5 .ic2,.mv5 .cgrid>div,.mv5 .wgrid>div,.mv5 .qc,.mv5 .oc{transition:transform .25s ease,box-shadow .25s ease}
.mv5 .fc:hover,.mv5 .ic2:hover,.mv5 .cgrid>div:hover,.mv5 .wgrid>div:hover,.mv5 .qc:hover,.mv5 .oc:hover{transform:translateY(-5px);box-shadow:0 16px 34px rgba(61,15,39,.10)}
.mv5 .photo{overflow:hidden}
.mv5 .photo img{transition:transform .6s cubic-bezier(.2,.7,.2,1)}
.mv5 .photo:hover img,.mv5 figure:hover .photo img{transform:scale(1.04)}
.mv5 .btn{transition:background .2s,transform .2s}
.mv5 .btn:hover{transform:translateY(-2px)}
.mv5 .btn:not(.o)::after{content:"→";display:inline-block;transition:transform .2s;margin-left:2px}
.mv5 .btn:not(.o):hover::after{transform:translateX(4px)}
@media (prefers-reduced-motion:no-preference){.mv5 .close .mvsmile img{animation:mvbreath 10s ease-in-out infinite alternate;transform-origin:70% 40%}}
.mv5 .close .mvsmile img{object-position:72% 30%}
/* rotating seal on hero */
.mv5 .mvseal{position:absolute;z-index:3;left:calc(50% - 20px);bottom:9%;width:128px;height:128px;border-radius:50%;background:var(--paper,#fbf7f4);box-shadow:0 12px 30px rgba(61,15,39,.14);display:grid;place-items:center}
.mv5 .mvseal svg{position:absolute;inset:0;width:100%;height:100%}
.mv5 .mvseal text{font:800 10.5px/1 'Inter',sans-serif;letter-spacing:.16em;fill:var(--plum,#3d0f27)}
.mv5 .mvseal b{font-family:var(--display);font-weight:900;font-size:30px;letter-spacing:-.03em;color:var(--berry,#8e2a5a);line-height:1}
/* big quiet marquee */
.mv5 .mvmq{overflow:hidden;border-block:1.5px solid rgba(61,15,39,.12);background:var(--paper,#fbf7f4);padding:22px 0}
.mv5 .mvmq .t{display:flex;align-items:center;width:max-content;gap:0;white-space:nowrap}
.mv5 .mvmq span{font-family:var(--display);font-weight:900;font-size:clamp(28px,4vw,52px);letter-spacing:-.03em;color:var(--plum,#3d0f27);padding:0 28px}
.mv5 .mvmq span:nth-child(even){color:transparent;-webkit-text-stroke:1.5px var(--berry,#8e2a5a)}
.mv5 .mvmq i{font-style:normal;color:var(--berry,#8e2a5a);font-size:clamp(18px,2.2vw,28px);line-height:1}
@media (max-width:860px){.mv5 .hero.hb.hbm .hbimg{aspect-ratio:1/1}.mv5 .hero.hb.hbm .hbimg img{object-position:center 92%}}
@media (max-width:860px){.mv5 .hero.hb,.mv5 .hero.hb .hbimg{overflow:visible}.mv5 .hero.hb .kick{max-width:240px}.mv5 .mvseal{width:88px;height:88px;left:auto;right:16px;bottom:-42px;top:auto}.mv5 .mvseal b{font-size:22px}.mv5 .mvseal text{font-size:9px}}

@media (prefers-reduced-motion:no-preference){
.mv5 .mvseal svg{animation:mvspin 22s linear infinite}
@keyframes mvspin{to{transform:rotate(360deg)}}
.mv5 .mvmq .t{animation:mvmq 38s linear infinite}
@keyframes mvmq{to{transform:translateX(-50%)}}
}
</style>
<script>
(function(){
var root=document;if(!document.querySelector('.hero'))return;
var red=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
var h1=root.querySelector('.hero h1');if(h1&&!red)h1.classList.add('mvh');
/* seal */
var hb=root.querySelector('.hero.hb');
if(hb){var s=document.createElement('div');s.className='mvseal';s.setAttribute('aria-hidden','true');
s.innerHTML='<svg viewBox="0 0 128 128"><defs><path id="mvsp" d="M64,64 m-50,0 a50,50 0 1,1 100,0 a50,50 0 1,1 -100,0"/></defs><text><textPath href="#mvsp">FOUNDING 500 · 20% OFF · FREE DELIVERY ON 2+ · </textPath></text></svg><b>20%</b>';
(window.innerWidth<860?hb.querySelector('.hbimg'):hb).appendChild(s);}
/* marquee */
var anchor=root.querySelector('.offer');
if(anchor){var m=document.createElement('div');m.className='mvmq';m.setAttribute('aria-hidden','true');
var w=['All dose.','No drama.','Two a day.','180mg on the front.','30-day satisfaction guarantee.','Not for you? Refunded.'];var h='';for(var k=0;k<2;k++)w.forEach(function(x){h+='<span>'+x+'</span><span><i>✦</i></span>'.replace('<span><i>','<i style="padding:0 6px">').replace('</i></span>','</i>')});
m.innerHTML='<div class="t">'+h+'</div>';anchor.parentNode.insertBefore(m,anchor);}
/* strike the excuses */
(function(){var xs=[].slice.call(document.querySelectorAll('.mv5 .ex'));if(!xs.length)return;
if(!('IntersectionObserver' in window)||window.matchMedia('(prefers-reduced-motion: reduce)').matches){xs.forEach(function(e){e.classList.add('in')});return}
var o=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');o.unobserve(x.target)}})},{threshold:.6});xs.forEach(function(e){o.observe(e)})})();
/* stamp the claims */
(function(){var g=document.querySelector('.mv5 .stamped');if(!g)return;if(!('IntersectionObserver' in window)){g.classList.add('in');return}
var o=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){g.classList.add('in');o.disconnect()}})},{threshold:.35});o.observe(g)})();
/* reveal on scroll */
var sel='.mv5 section:not(.hero) h2,.mv5 section:not(.hero) .kick,.band2 .wrap>div,.qgrid>*,.wgrid>div,.mvclub,.ritbox,.ngrid>div,.fc,.ingrid .photo,.ic2,.cgrid>div,.mgrid figure,.tbox,.oc,.qc,.faq details,.close .box';
var els=[].slice.call(document.querySelectorAll(sel));
if(!red&&'IntersectionObserver' in window){
 els.forEach(function(e){var sib=e.parentNode?[].slice.call(e.parentNode.children).indexOf(e):0;e.style.setProperty('--d',Math.min(sib,6)*0.08+'s');e.classList.add('mvr')});
 var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.12,rootMargin:'0px 0px -6% 0px'});
 els.forEach(function(e){io.observe(e)});
}
/* count-up numbers */
var nums=[].slice.call(document.querySelectorAll('.nums .ngrid b'));
if(!red&&nums.length&&'IntersectionObserver' in window){
 var io2=new IntersectionObserver(function(es){es.forEach(function(x){if(!x.isIntersecting)return;io2.unobserve(x.target);var b=x.target,t=null;
  for(var c=b.firstChild;c;c=c.nextSibling){if(c.nodeType===3&&/\d/.test(c.textContent)){t=c;break}}if(!t)return;
  var end=parseInt(t.textContent,10),st=null;function step(ts){if(!st)st=ts;var p=Math.min((ts-st)/1100,1);t.textContent=String(Math.round(end*(1-Math.pow(1-p,3))));if(p<1)requestAnimationFrame(step)}t.textContent='0';requestAnimationFrame(step)})},{threshold:.4});
 nums.forEach(function(n){io2.observe(n)});
}
})();
</script>
{%- endunless -%}

