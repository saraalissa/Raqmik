{%- comment -%}
  Mëva listicle landing page for the "honest label" ads (R3 angle H).
  One action only: join the free waitlist. No prices, packs or cart links. Header nav and pop-up hidden.
  Psychology: blame removed from the reader ("it isn't you"), autonomy (a check she can run on any jar, ours included),
  authority from UK rules (not from us), a recap she can act on now, then the reveal.
{%- endcomment -%}
{%- assign brand = section.settings.brand_name -%}
<style>
body:has(.lpx) .hnav,body:has(.lpx) .mnav,body:has(.lpx) .mv5-head .ann,body:has(.lpx) .ftr .nletter{display:none!important}
@media (max-width:600px){.mv5 .lpx-hero{padding-top:16px}.mv5 .lpx .dek{margin-bottom:12px}}
.mv5 .lpx-ad{background:var(--plum);color:#f3dbe7;text-align:center;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;padding:8px 16px}
.mv5 .lpx .wrap{max-width:680px}
.mv5 .lpx-hero{padding-block:clamp(22px,4vw,48px) 8px}
.mv5 .lpx-hero h1{font-size:clamp(31px,4.8vw,50px);line-height:1.04;letter-spacing:-.03em;margin:10px 0 0}
.mv5 .lpx-hero h1 em{font-style:normal;color:var(--berry)}
.mv5 .lpx .dek{font-size:17.5px;line-height:1.6;color:#5a3e4d;margin:14px 0 16px}
.mv5 .lpx .dek b{color:var(--plum)}
.mv5 .lpx .trustl{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12.5px;font-weight:700;color:var(--plum);margin:10px 0 0}
.mv5 .lpx .trustl span{display:inline-flex;gap:6px;align-items:center}
.mv5 .lpx .trustl span:before{content:"";width:7px;height:7px;border-radius:50%;background:var(--berry)}
.mv5 .lpx .mvclub{max-width:none}
.mv5 .lpx-body{padding-block:clamp(26px,4vw,48px) clamp(40px,6vw,72px)}
.mv5 .lpx-it{display:grid;gap:12px;padding-block:28px;border-top:1.5px solid var(--line)}
.mv5 .lpx-it .n{display:flex;gap:14px;align-items:baseline}
.mv5 .lpx-it .n b{flex:0 0 auto;font-family:var(--display);font-weight:900;font-size:44px;line-height:.9;color:var(--berry);letter-spacing:-.04em}
.mv5 .lpx-it h2{font-size:clamp(22px,3vw,28px);line-height:1.15;margin:0}
.mv5 .lpx-it p{font-size:17px;line-height:1.7;color:#5a3e4d;margin:0}
.mv5 .lpx-it p b{color:var(--plum)}
.mv5 .lbl{background:#fffdf8;border:1.5px dashed rgba(92,22,56,.35);border-radius:18px;padding:16px 18px;font-family:ui-monospace,Menlo,Consolas,monospace;font-size:14.5px;color:#3b2230;display:grid;gap:6px}
.mv5 .lbl .r{display:flex;justify-content:space-between;gap:12px;border-bottom:1px dotted rgba(0,0,0,.2);padding-bottom:6px}
.mv5 .lbl .r:last-of-type{border-bottom:0;padding-bottom:0}
.mv5 .lbl .q{color:var(--berry);font-weight:800}
.mv5 .lbl small{font-family:inherit;font-size:11.5px;color:var(--muted);letter-spacing:.04em;text-transform:uppercase}
.mv5 .ours{display:flex;gap:10px;align-items:flex-start;background:var(--lilac);border-radius:16px;padding:12px 14px;font-weight:700;color:var(--plum);font-size:15.5px;line-height:1.45}
.mv5 .ours i{font-style:normal;flex:0 0 auto;background:var(--plum);color:#fff;border-radius:999px;font-size:11px;letter-spacing:.1em;text-transform:uppercase;padding:4px 9px;margin-top:1px}
.mv5 .lpx ul.cl{list-style:none;padding:0;margin:0;display:grid;gap:8px;font-weight:600;font-size:15.5px;color:var(--plum)}
.mv5 .lpx .shot{border-radius:22px;overflow:hidden;background:var(--lilac)}
.mv5 .lpx .shot img{display:block;width:100%;height:auto}
.mv5 .recap{background:var(--cream);border-radius:26px;padding:clamp(22px,4vw,34px);display:grid;gap:14px;margin-top:8px}
.mv5 .recap h2{font-size:clamp(24px,3.2vw,32px);margin:0}
.mv5 .recap ol{margin:0;padding:0;list-style:none;counter-reset:r;display:grid;gap:10px}
.mv5 .recap li{counter-increment:r;display:grid;grid-template-columns:30px 1fr;gap:10px;align-items:start;font-weight:600;color:var(--plum);font-size:16px;line-height:1.45}
.mv5 .recap li:before{content:counter(r);width:30px;height:30px;border-radius:50%;background:#fff;color:var(--berry);display:flex;align-items:center;justify-content:center;font-family:var(--display);font-weight:900}
.mv5 .recap p{margin:0;color:#5a3e4d;font-size:16px;line-height:1.6}
.mv5 .reveal{display:grid;gap:16px;margin-top:40px}
