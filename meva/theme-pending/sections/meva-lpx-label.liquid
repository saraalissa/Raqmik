.mv5 .facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.mv5 .facts div{background:#fff;border:1.5px solid var(--line);border-radius:18px;padding:14px}
.mv5 .facts b{display:block;font-family:var(--display);font-weight:900;font-size:26px;color:var(--berry);letter-spacing:-.03em;line-height:1}
.mv5 .facts span{display:block;font-size:13.5px;font-weight:600;color:var(--plum);margin-top:6px;line-height:1.35}
.mv5 .lpx-end{background:var(--cream);padding-block:clamp(36px,5vw,64px);scroll-margin-top:20px}
.mv5 .lpx-end .wrap{display:grid;gap:18px}
.mv5 .lpx-end .mvclub{background:#fff}
.mv5 .faq{display:grid;gap:8px;margin-top:6px}
.mv5 .faq details{background:#fff;border-radius:16px;padding:14px 16px;border:1.5px solid var(--line)}
.mv5 .faq summary{font-weight:800;color:var(--plum);cursor:pointer;font-size:16px}
.mv5 .faq p{margin:8px 0 0;color:#5a3e4d;font-size:15.5px;line-height:1.6}
.mv5 .fp{font-size:12.5px;color:var(--muted);line-height:1.5;margin:6px 0 0}
.mv5 .lpx-sb{display:none}
@media (max-width:900px){
  .mv5 .lpx-sb{display:flex;position:fixed;left:0;right:0;bottom:0;z-index:25;background:#fff;border-top:1.5px solid var(--line);align-items:center;justify-content:space-between;gap:12px;padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));transform:translateY(110%);transition:transform .25s}
  .mv5 .lpx-sb.on{transform:none}
  .mv5 .lpx-sb b{display:block;font-family:var(--display);font-weight:900;color:var(--plum);font-size:15px;line-height:1.15}
