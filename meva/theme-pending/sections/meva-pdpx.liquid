 var io=new IntersectionObserver(function(es){es.forEach(function(x){if(x.isIntersecting){x.target.classList.add('in');io.unobserve(x.target)}})},{threshold:.12,rootMargin:'0px 0px -6% 0px'});
 els.forEach(function(e){io.observe(e)});
}
/* count-up numbers */
var nums=[].slice.call(document.querySelectorAll('.nums .ngrid b'));
if(!red&&nums.length&&'IntersectionObserver' in window){
 var io2=new IntersectionObserver(function(es){es.forEach(function(x){if(!x.isIntersecting)return;io2.unobserve(x.target);var b=x.target,t=null;
  for(var c=b.firstChild;c;c=c.nextSibling){if(c.nodeType===3&&/\d/.test(c.textContent)){t=c;break}}if(!t)return;
  var end=parseInt(t.textContent,10),st=null;function step(ts){if(!st)st=ts;var p=Math.min((ts-st)/1100,1);t.textContent=String(Math.round(end*(1-Math.pow(1-p,3))));if(p<1)requestAnimationFrame(step)}t.textContent='0';requestAnimationFrame(step)})},{threshold:.4});
 nums.forEach(function(n){io2.observe(n)});
}
})();
