<script>
(function(){var tl=document.querySelector('.mv5 .ptabs .tl');if(!tl)return;tl.addEventListener('click',function(e){var b=e.target.closest('button[data-tab]');if(!b)return;tl.querySelectorAll('button').forEach(function(x){x.setAttribute('aria-selected',x===b?'true':'false');});document.querySelectorAll('.mv5 .ptabs .tpan').forEach(function(p){p.hidden=p.getAttribute('data-pan')!==b.getAttribute('data-tab');});});})();
(function () {
  var stage = document.getElementById('mv-stage');
  if (stage) {
    var slides = [].slice.call(stage.querySelectorAll('.slide'));
    var thumbs = [].slice.call(document.querySelectorAll('#mv-thumbs button'));
    var cur = 0;
    function go(i) {
      cur = (i + slides.length) % slides.length;
      slides.forEach(function (s, k) { if (k === cur) s.setAttribute('data-on', ''); else s.removeAttribute('data-on'); });
      thumbs.forEach(function (b, k) { b.setAttribute('aria-pressed', k === cur ? 'true' : 'false'); });
    }
    thumbs.forEach(function (b, k) { b.addEventListener('click', function () { go(k); }); });
    stage.querySelector('[data-mv-prev]').addEventListener('click', function () { go(cur - 1); });
    stage.querySelector('[data-mv-next]').addEventListener('click', function () { go(cur + 1); });
  }
  var form = document.getElementById('mv-buy');
  if (!form) return;
  var WL = {{ wl | json }};
  if (WL) form.addEventListener('submit', function (e) { e.preventDefault(); var r = form.querySelector('input[name=id]:checked'); var pk = r ? r.getAttribute('data-pack') : '2'; window.location.href = window.location.pathname + '?reserve=' + pk + '#club'; });
  function upd() {
    var r = form.querySelector('input[name=id]:checked');
    if (!r) return;
    var btn = document.getElementById('mv-add');
    var ok = WL || r.getAttribute('data-avail') === 'true';
    btn.disabled = !ok;
    btn.textContent = ok ? (WL ? 'Reserve mine' : 'Add to basket · ' + r.getAttribute('data-price')) : 'Sold out';
    var sb = document.querySelector('.mv5 .sbar button.btn'); if (sb) { sb.disabled = !ok; sb.textContent = ok ? 'Add to basket' : 'Sold out'; }
    document.getElementById('mv-sbp').textContent = WL ? r.getAttribute('data-note').split(' · ')[0] : r.getAttribute('data-price');
    document.getElementById('mv-sbt').textContent = WL ? 'Nothing to pay today' : r.getAttribute('data-note');
    var url = new URL(window.location.href);
    if (!WL) url.searchParams.set('variant', r.value);
    window.history.replaceState({}, '', url.toString());
  }
  var rs = new URLSearchParams(location.search).get('reserve'); if (rs) { var ri = form.querySelector('input[data-pack="' + rs.replace(/[^0-9]/g,'') + '"]'); if (ri) ri.checked = true; }
  form.querySelectorAll('input[name=id]').forEach(function (i) { i.addEventListener('change', upd); });
  upd();
})();
</script>
