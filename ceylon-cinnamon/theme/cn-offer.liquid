{{ 'cn.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.product | default: collections.all.products.first
  assign counts = section.settings.counts | split: ','
-%}
<section class="cn cn-sec {{ section.settings.style }}" id="offer">
  <div class="cn-wrap">
    <div class="cn-center">
      {% if section.settings.eyebrow != blank %}<span class="cn-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="cn-h2">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="cn-lead">{{ section.settings.subheading }}</p>{% endif %}
    </div>
    {%- if p -%}
    <div class="cn-offers">
      {%- for v in p.variants limit: 3 -%}
        {%- liquid
          assign n = counts[forloop.index0] | strip | plus: 0
          if n < 1
            assign n = 1
          endif
          assign per = v.price | divided_by: n
          assign pop = false
          if forloop.index == section.settings.popular
            assign pop = true
          endif
        -%}
        <div class="cn-offer{% if pop %} cn-offer--pop{% endif %}">
          {% if pop %}<span class="cn-offer__flag">{{ section.settings.popular_label }}</span>{% endif %}
          <div class="cn-offer__title">{{ v.title }}</div>
          <div class="cn-offer__price">{{ v.price | money }}</div>
          {% if v.compare_at_price > v.price %}<div class="cn-offer__was">{{ v.compare_at_price | money }}</div>{% endif %}
          <span class="cn-offer__per">{{ per | money }} {{ section.settings.per_label }}</span>
          {%- form 'product', p -%}
            <input type="hidden" name="id" value="{{ v.id }}">
            <button type="submit" class="cn-btn cn-btn--block"{% unless v.available %} disabled{% endunless %}>{% if v.available %}{{ section.settings.button_label }}{% else %}Sold out{% endif %}</button>
          {%- endform -%}
        </div>
      {%- endfor -%}
    </div>
    {%- endif -%}
    {% if section.settings.note != blank %}<p class="cn-note" style="text-align:center;margin-top:22px">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "CN · Bundle offer",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "select", "id": "style", "label": "Background", "default": "", "options": [{ "value": "", "label": "White" }, { "value": "cn-sand", "label": "Sand" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Pick your supply" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "counts", "label": "Pouches per variant (comma list)", "default": "1,3,5" },
    { "type": "range", "id": "popular", "label": "Most popular variant", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "popular_label", "label": "Popular label", "default": "Most popular" },
    { "type": "text", "id": "per_label", "label": "Per-pouch label", "default": "per pouch" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "note", "label": "Note under cards" }
  ],
  "presets": [{ "name": "CN · Bundle offer" }]
}
{% endschema %}
