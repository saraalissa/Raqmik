{{ 'cn.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign counts = section.settings.counts | split: ','
  assign default_index = section.settings.default_variant | minus: 1
  if default_index >= product.variants.size
    assign default_index = 0
  endif
-%}
<section class="cn" id="buy">
  <div class="cn-wrap cn-pdp">
    <div class="cn-pdp__gallery">
      <div class="cn-gallery__main" aria-label="{{ product.title | escape }}">
        {%- for m in product.media -%}
          {%- if m.media_type == 'image' -%}
            {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
            {{ m.preview_image | image_url: width: 1200 | image_tag: loading: ld, sizes: '(min-width: 900px) 55vw, 100vw', alt: m.alt, id: 'cn-media-' | append: forloop.index }}
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag }}
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <div class="cn-gallery__thumbs">
          {%- for m in product.media -%}<a href="#cn-media-{{ forloop.index }}" aria-label="Image {{ forloop.index }}">{{ m.preview_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}</a>{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
    <div>
      {% if section.settings.eyebrow != blank %}<span class="cn-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h1 class="cn-pdp__title">{{ product.title }}</h1>
      {% if section.settings.rating_line != blank %}<p class="cn-note" style="margin-top:8px">{{ section.settings.rating_line }}</p>{% endif %}
      <ul class="cn-ticks">
        {%- for block in section.blocks -%}<li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>{%- endfor -%}
      </ul>
      {%- form 'product', product, id: 'cn-product-form' -%}
        <fieldset class="cn-pick" style="border:0;padding:0;margin:18px 0">
          <legend class="cn-h3" style="margin-bottom:8px">{{ section.settings.pick_label }}</legend>
          {%- for v in product.variants -%}
            {%- liquid
              assign n = counts[forloop.index0] | strip | plus: 0
              if n < 1
                assign n = 1
              endif
              assign per = v.price | divided_by: n
            -%}
            <div>
              <input type="radio" name="id" id="cn-v-{{ v.id }}" value="{{ v.id }}" {% if forloop.index0 == default_index %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
              <label for="cn-v-{{ v.id }}">
                {% if forloop.index == section.settings.popular %}<span class="cn-pick__flag">{{ section.settings.popular_label }}</span>{% endif %}
                <span class="cn-pick__dot" aria-hidden="true"></span>
                <span><span class="cn-pick__name">{{ v.title }}</span><br><span class="cn-pick__sub">{{ per | money }} {{ section.settings.per_label }}</span></span>
                <span class="cn-pick__price">{{ v.price | money }}{% if v.compare_at_price > v.price %}<s>{{ v.compare_at_price | money }}</s>{% endif %}</span>
              </label>
            </div>
          {%- endfor -%}
        </fieldset>
        <input type="hidden" name="quantity" value="1">
        <button type="submit" class="cn-btn cn-btn--block">{{ section.settings.button_label }}</button>
        <div style="margin-top:10px">{{ form | payment_button }}</div>
      {%- endform -%}
      <div class="cn-assure">
        <div><b>{{ section.settings.a1_title }}</b>{{ section.settings.a1_text }}</div>
        <div><b>{{ section.settings.a2_title }}</b>{{ section.settings.a2_text }}</div>
        <div><b>{{ section.settings.a3_title }}</b>{{ section.settings.a3_text }}</div>
      </div>
      {%- if product.description != blank -%}
        <details class="cn-faq" style="margin-top:18px"><summary>{{ section.settings.details_label }}</summary><div class="cn-faq__a">{{ product.description }}</div></details>
      {%- endif -%}
    </div>
  </div>
  <div class="cn-sticky">
    <div><b>{{ product.price | money }}</b><br><span class="cn-note">{{ section.settings.sticky_note }}</span></div>
    <a class="cn-btn" href="#cn-product-form">{{ section.settings.sticky_label }}</a>
  </div>
</section>
{% schema %}
{
  "name": "CN · Buy box",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "True Ceylon cinnamon" },
    { "type": "text", "id": "rating_line", "label": "Line under title (no fake ratings)" },
    { "type": "text", "id": "pick_label", "label": "Bundle picker label", "default": "Choose your supply" },
    { "type": "text", "id": "counts", "label": "Pouches per variant (comma list)", "default": "1,3,5" },
    { "type": "range", "id": "default_variant", "label": "Pre-selected variant", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "popular", "label": "Most popular variant", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "text", "id": "popular_label", "label": "Popular label", "default": "Most popular" },
    { "type": "text", "id": "per_label", "label": "Per-pouch label", "default": "per pouch" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "a1_title", "label": "Assurance 1 title", "default": "90 days" },
    { "type": "text", "id": "a1_text", "label": "Assurance 1 text", "default": "money-back" },
    { "type": "text", "id": "a2_title", "label": "Assurance 2 title", "default": "Free US" },
    { "type": "text", "id": "a2_text", "label": "Assurance 2 text", "default": "shipping over $60" },
    { "type": "text", "id": "a3_title", "label": "Assurance 3 title", "default": "Cancel" },
    { "type": "text", "id": "a3_text", "label": "Assurance 3 text", "default": "anytime" },
    { "type": "text", "id": "details_label", "label": "Details label", "default": "What's inside & how to take it" },
    { "type": "text", "id": "sticky_note", "label": "Sticky bar note", "default": "90-day guarantee" },
    { "type": "text", "id": "sticky_label", "label": "Sticky bar button", "default": "Choose my supply" }
  ],
  "blocks": [{ "type": "tick", "name": "Benefit", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Benefit" }] }]
}
{% endschema %}
