{{ 'cn.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign p = section.settings.product | default: product | default: collections.all.products.first
  assign counts = section.settings.counts | split: ','
  assign days = section.settings.days_per_pouch | default: 30
-%}
<section class="cn cn-sec {{ section.settings.style }}">
  <div class="cn-wrap">
    <div class="cn-center">
      {% if section.settings.eyebrow != blank %}<span class="cn-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="cn-h2">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="cn-lead">{{ section.settings.subheading }}</p>{% endif %}
    </div>
    {%- if p -%}
    <div class="cn-perday">
      {%- for v in p.variants limit: 3 -%}
        {%- liquid
          assign n = counts[forloop.index0] | strip | plus: 0
          if n < 1
            assign n = 1
          endif
          assign total_days = n | times: days
          assign per_day = v.price | divided_by: total_days
        -%}
        <div class="cn-perday__item{% if forloop.last %} is-best{% endif %}">
          <span class="cn-perday__name">{{ v.title }}</span>
          <b class="cn-perday__price">{{ per_day | money }}</b>
          <span class="cn-note">{{ section.settings.per_day_label }}</span>
          <div class="cn-perday__bar" style="--w: {{ 100 | divided_by: forloop.index }}%"></div>
        </div>
      {%- endfor -%}
      <div class="cn-perday__item cn-perday__coffee">
        <span class="cn-perday__name">{{ section.settings.compare_name }}</span>
        <b class="cn-perday__price">{{ section.settings.compare_price }}</b>
        <span class="cn-note">{{ section.settings.compare_note }}</span>
      </div>
    </div>
    {%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "CN · Cost per day",
  "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "select", "id": "style", "label": "Background", "default": "cn-sand", "options": [{ "value": "", "label": "White" }, { "value": "cn-sand", "label": "Sand" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Less than your morning coffee" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "counts", "label": "Pouches per variant (comma list)", "default": "1,3,5" },
    { "type": "number", "id": "days_per_pouch", "label": "Days per pouch", "default": 30 },
    { "type": "text", "id": "per_day_label", "label": "Per-day label", "default": "per day" },
    { "type": "text", "id": "compare_name", "label": "Comparison item", "default": "A coffee-shop latte" },
    { "type": "text", "id": "compare_price", "label": "Comparison price", "default": "$5+" },
    { "type": "text", "id": "compare_note", "label": "Comparison note", "default": "and gone in 10 minutes" }
  ],
  "presets": [{ "name": "CN · Cost per day" }]
}
{% endschema %}
