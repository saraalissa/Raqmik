{{ 'cn.css' | asset_url | stylesheet_tag }}
<section class="cn cn-sec {{ section.settings.style }}">
  <div class="cn-wrap">
    <div class="cn-center">
      {% if section.settings.eyebrow != blank %}<span class="cn-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="cn-h2">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}<p class="cn-lead">{{ section.settings.subheading }}</p>{% endif %}
    </div>
    <div class="cn-grid cn-grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="cn-card{% if block.settings.accent %} cn-card--accent{% endif %}" {{ block.shopify_attributes }}>
          {% if block.settings.tag != blank %}<span class="cn-tag">{{ block.settings.tag }}</span>{% endif %}
          {% if block.settings.big != blank %}<div class="cn-big">{{ block.settings.big }}</div>{% endif %}
          {% if block.settings.title != blank %}<h3 class="cn-h3">{{ block.settings.title }}</h3>{% endif %}
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
    {% if section.settings.button_label != blank %}
      <div style="text-align:center;margin-top:32px"><a class="cn-btn" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a></div>
    {% endif %}
    {% if section.settings.note != blank %}<p class="cn-note" style="text-align:center;margin-top:18px">{{ section.settings.note }}</p>{% endif %}
  </div>
</section>
{% schema %}
{
  "name": "CN · Cards",
  "settings": [
    { "type": "select", "id": "style", "label": "Background", "default": "", "options": [{ "value": "", "label": "White" }, { "value": "cn-sand", "label": "Sand" }, { "value": "cn-dark", "label": "Dark" }] },
    { "type": "select", "id": "columns", "label": "Columns", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Heading" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "note", "label": "Small note" }
  ],
  "blocks": [{ "type": "card", "name": "Card", "settings": [
    { "type": "text", "id": "tag", "label": "Tag" },
    { "type": "text", "id": "big", "label": "Big number or word" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "accent", "label": "Highlight", "default": false }
  ] }],
  "presets": [{ "name": "CN · Cards" }]
}
{% endschema %}
